---
import BaseLayout from '../layouts/BaseLayout.astro';
import waline from '../config/waline.json';

const walineReady = Boolean(waline.serverURL);
---

<BaseLayout activeNav="guestbook" title="Guestbook — MODUSENSUS">
  <header class="container page-header">
    <div class="mono-label">GUESTBOOK</div>
    <h1 class="page-header-title">OPEN<br />CHANNEL</h1>
    <p class="page-header-subtitle">留言板 — LEAVE A NOTE / SAY HELLO</p>
  </header>

  <div class="container board">
    <hr class="board-rule" />
    <div class="community-page">
      <div class="guestbook-intro">
        <p>如果你有想说的话，欢迎留下来。</p>
        <p class="mono-meta">昵称和邮箱为必填项，网址选填；填写邮箱可订阅回复通知。留言公开显示。</p>
      </div>

      <div class="waline-shell">
        {walineReady ? (
          <div class="waline" aria-label="Guestbook comments"></div>
        ) : (
          <div class="community-setup">
            <div class="community-setup-title">CHANNEL NOT CONFIGURED</div>
            <p class="community-setup-copy">留言板页面已经准备好，但评论服务还没有完成连接。</p>
            <p class="community-setup-copy">把 Waline 服务端地址填入 `src/config/waline.json` 后，留言功能会自动启用。</p>
          </div>
        )}
      </div>

      <!-- 全站留言流：聚合所有页面（文章评论区 + 留言板）的最新公开留言 -->
      <div class="gb-latest" id="gb-latest" hidden>
        <div class="mono-label gb-latest-label">LATEST · 全站最新留言</div>
        <p class="gb-latest-note mono-meta">来自全站所有页面的公开留言与文章讨论，实时同步。</p>
        <div class="rc-list" id="gb-latest-list" hidden></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Waline 客户端走 npm 打包（同源加载，不依赖第三方 CDN）；服务地址配置在 src/config/waline.json
  // 站点启用了 <ViewTransitions />：打包脚本在一次完整加载中只执行一次，客户端路由切页不会重跑，
  // 因此初始化必须挂到 astro:page-load（首次加载与每次路由切换后都会触发），否则从其他页面进来评论框不出现
  import { init } from '@waline/client';
  import '@waline/client/style';
  import { serverURL } from '../config/waline.json';
  import { fetchRecentComments, renderRecentList } from '../lib/recent-comments';

  let walineInstance = null;

  function mountWaline() {
    if (walineInstance) {
      try { walineInstance.destroy(); } catch { /* 已销毁 */ }
      walineInstance = null;
    }
    const mount = document.querySelector('.waline');
    if (mount && !mount.dataset.walineMounted) {
      mount.dataset.walineMounted = 'true'; // 同一 DOM 只挂载一次，防止重复 init
      walineInstance = init({
        el: mount,
        serverURL,
        lang: 'zh-CN',
        // 固定 path，避免尾斜杠变化导致留言被拆到两个路径下
        path: '/guestbook',
        // 传 CSS 选择器而非 'auto'：跟随站点 data-theme 切换，主题按钮点击即时生效
        dark: ":root[data-theme='dark']",
        meta: ['nick', 'mail', 'link'],
        // 昵称/邮箱必填；不在列表内的字段（网址）会被 Waline 自动标注「(选填)」
        requiredMeta: ['nick', 'mail'],
        search: false,
        pageSize: 10,
      });
    }
  }

  // 右上角读者入口弹窗登录成功后广播该事件，重建评论框以读取最新登录态
  document.addEventListener('modusensus:waline-user', mountWaline);
  document.addEventListener('astro:page-load', mountWaline);

  // ── 全站最新留言：Waline recent API（失败/为空时整块隐藏） ──
  function loadLatest() {
    const wrap = document.getElementById('gb-latest');
    const listEl = document.getElementById('gb-latest-list');
    if (!wrap || !listEl) return;
    fetchRecentComments(serverURL, 8)
      .then(items => {
        if (!items.length) { wrap.hidden = true; return; }
        renderRecentList(listEl, items);
        listEl.hidden = false;
        wrap.hidden = false;
      })
      .catch(() => { wrap.hidden = true; });
  }
  document.addEventListener('astro:page-load', loadLatest);
</script>

<!-- Waline 主题覆盖已上移到 global.css（文章页评论区也用同一套） -->

<style>
.guestbook-intro {
  max-width: 560px;
  padding: 0 0 22px;
  border-bottom: 1px solid var(--rule);
}
.guestbook-intro p:first-child {
  font-family: var(--font-cn);
  font-size: 21px;
  line-height: 1.7;
  margin-bottom: 12px;
}
.guestbook-intro .mono-meta {
  line-height: 1.8;
  text-transform: none;
  letter-spacing: 0.04em;
}
.gb-latest {
  margin-top: 56px;
  padding-top: 40px;
  border-top: 1px solid var(--rule);
}
.gb-latest-label { color: var(--ink); margin-bottom: 8px; }
.gb-latest-note {
  margin: 0 0 10px;
  text-transform: none;
  letter-spacing: 0.04em;
}
</style>
