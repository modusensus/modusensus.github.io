---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.module === 'threshold')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function fmtShort(date: Date) {
  const m = date.toLocaleDateString('en-US', { month: 'short' });
  return `${m}. ${String(date.getDate()).padStart(2, '0')}`;
}
---

<BaseLayout activeNav="threshold" title="Threshold Notes — MODUSENSUS">
  <header class="container page-header">
    <div class="column-art-wrap" aria-hidden="true">
      <img class="column-art" data-art="light" src="/images/columns/threshold-light.png" alt="" width="480" height="480" loading="lazy" />
      <img class="column-art" data-art="dark" src="/images/columns/threshold-dark.png" alt="" width="480" height="480" loading="lazy" />
    </div>
    <div class="mono-label">01 — MAGAZINE</div>
    <h1 class="page-header-title">THRESHOLD<br />NOTES</h1>
    <p class="page-header-subtitle">数字思想杂志 — ESSAY / HUMANITY / TECHNOLOGY</p>
  </header>

  <div class="container board">
    <hr class="board-rule" />
    <div class="list-narrow">
      {posts.map((post, idx) => (
        <a
          class="tn-item"
          href={`/blog/${post.slug}`}
          data-desc={post.data.subtitle || post.data.excerpt || ''}
          data-ai={post.data.ai ? 'ai' : undefined}
        >
          <div class="tn-meta">
            <span>No. {post.data.issue || String(posts.length - idx).padStart(2, '0')}</span>
            <span>{fmtShort(post.data.date)} · <span class="waline-pageview-count" data-path={`/blog/${post.slug}`}>–</span> VIEWS</span>
          </div>
          <div class="tn-title">{post.data.title}</div>
          {post.data.subtitle && <div class="tn-desc">{post.data.subtitle}</div>}
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="tn-tags">
              {post.data.tags.map(t => <span class="tn-tag">#{t}</span>)}
            </div>
          )}
        </a>
      ))}
      {posts.length === 0 && <p class="mono-meta">NO ENTRIES YET.</p>}
    </div>
  </div>
</BaseLayout>
