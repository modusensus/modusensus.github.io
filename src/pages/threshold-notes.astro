---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.module === 'threshold')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout activeNav="threshold" title="Threshold Notes — MODUSENSUS">
  <header class="page-header">
    <h1 class="page-header-title">THRESHOLD NOTES</h1>
    <p class="page-header-subtitle">数字思想杂志 — Essay / Humanity / Technology</p>
  </header>

  <div class="page-layout">
    <aside class="page-col-left">
      <div class="card card-padded">
        <div class="card-label">About this section</div>
        <p style="font-size: 12px; color: var(--dust); line-height: 1.6; margin-bottom: 12px;">长期关注的思想议题，关于技术、城市与人类的交叉地带。</p>
        <div class="card-divider"></div>
        <div class="card-stat-row"><span>Articles</span><span>{posts.length}</span></div>
        <div class="card-stat-row"><span>Latest</span><span>{posts[0] ? formatDate(posts[0].data.date) : '—'}</span></div>
      </div>
      <div class="card card-padded">
        <div class="card-label">Categories</div>
        <span class="pill">算法</span>
        <span class="pill">城市</span>
        <span class="pill">人文</span>
      </div>
    </aside>

    <section class="page-col-main">
      {posts.map((post, idx) => (
        <article class="article-feed-card">
          <a href={`/blog/${post.slug}`} style="display: block;">
            <div class="article-feed-header">
              <div class="feed-avatar">TN</div>
              <div>
                <div class="feed-meta-name">Threshold Notes</div>
                <div class="feed-meta-date">{formatDate(post.data.date)} · NO.{post.data.issue || String(idx + 1).padStart(2, '0')}</div>
              </div>
            </div>
            <div class="feed-body">
              <h3 class="feed-title">{post.data.title}</h3>
              <p class="feed-excerpt">{post.data.subtitle || post.data.excerpt || ''}</p>
            </div>
            {post.data.cover ? (
              <img src={post.data.cover} alt={post.data.title} class="feed-cover" />
            ) : (
              <div class="feed-cover-placeholder threshold-gradient"></div>
            )}
            <div class="feed-footer">
              <span class="feed-read-btn">→ Read</span>
              <span class="feed-tag">#essay</span>
            </div>
          </a>
        </article>
      ))}
    </section>

    <aside class="page-col-right">
      <div class="card card-padded">
        <div class="card-label">Explore other sections</div>
        <div class="section-item">
          <div class="section-avatar">LB</div>
          <div>
            <div class="section-name">Lab</div>
            <div class="section-desc">AI experiments / tools</div>
            <a href="/lab"><button class="browse-btn">Browse →</button></a>
          </div>
        </div>
        <div class="section-item" style="margin-bottom: 0;">
          <div class="section-avatar">AR</div>
          <div>
            <div class="section-name">Archive</div>
            <div class="section-desc">知识档案</div>
            <a href="/archive"><button class="browse-btn">Browse →</button></a>
          </div>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
