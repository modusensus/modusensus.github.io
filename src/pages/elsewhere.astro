---
import BaseLayout from '../layouts/BaseLayout.astro';
import { elsewhereLinks, type ElsewhereKind } from '../data/elsewhere';

const groups: Array<{ kind: ElsewhereKind; label: string; title: string; copy: string }> = [
  {
    kind: 'friends',
    label: 'FRIENDS',
    title: 'FRIENDS',
    copy: '朋友们正在建造的地方。',
  },
  {
    kind: 'reading',
    label: 'READING',
    title: 'READING',
    copy: '我会反复回去看的工具、项目和资料。',
  },
];
---

<BaseLayout activeNav="elsewhere" title="Elsewhere — MODUSENSUS">
  <header class="container page-header">
    <div class="mono-label">ELSEWHERE</div>
    <h1 class="page-header-title">OTHER<br />PLACES</h1>
    <p class="page-header-subtitle">远方 — FRIENDS / READING / INSPIRATION</p>
  </header>

  <div class="container board">
    <hr class="board-rule" />
    <div class="elsewhere-list">
      {groups.map(group => {
        const links = elsewhereLinks.filter(link => link.kind === group.kind);
        return (
          <section class="external-group">
            <div class="mono-label group-label">{group.label}</div>
            <p class="external-group-copy">{group.copy}</p>
            {links.length > 0 && group.kind === 'friends' ? (
              <div class="friend-grid">
                {links.map(link => (
                  <a
                    class="friend-card"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.image && (
                      <img
                        class="friend-card-avatar"
                        src={link.image}
                        alt={`${link.name} 头像`}
                        loading="eager"
                        width="52"
                        height="52"
                      />
                    )}
                    <span class="friend-card-body">
                      <span class="friend-card-name">{link.name}</span>
                      <span class="friend-card-desc">{link.description}</span>
                    </span>
                    <span class="friend-card-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            ) : links.length > 0 ? (
              <div>
                {links.map(link => (
                  <a
                    class="external-row"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="external-name">{link.name}</span>
                    <span class="external-desc">{link.description}</span>
                    <span class="external-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <div class="empty-state-title">OPEN FOR EXCHANGE</div>
                <p class="empty-state-copy">友链位虚以待。欢迎交换链接，一起把小圈子连起来。</p>
              </div>
            )}
            {group.kind === 'friends' && (
              <div class="exchange-rules">
                <div class="mono-meta">HOW TO APPLY · 友链申请</div>
                <ul class="exchange-list">
                  <li>你的站点需要正常访问，且由你长期维护</li>
                  <li>先在我的站点留言板或 GitHub 上打个招呼，附上你的站点名称、链接、一句话介绍和头像图地址</li>
                  <li>内容不限主题，原创优先；拒绝纯采集、挂广告弹窗或含恶意内容的站点</li>
                  <li>交换后我会尽快把你的链接加进来，也会期待你把我加上 ↴</li>
                </ul>
                <div class="exchange-info">
                  <span class="mono-meta">MY INFO</span>
                  <code>title: MODUSENSUS</code>
                  <code>description: 城市、数据与创造力的交汇处，写博客也做小工具。</code>
                  <code>website: https://modusensus.space/</code>
                  <code>image: https://modusensus.space/images/profile-avatar.jpg</code>
                </div>
                <div class="exchange-actions">
                  <a class="col-more" href="/guestbook">LEAVE A NOTE →</a>
                  <a class="col-more" href="https://github.com/modusensus" target="_blank" rel="noopener noreferrer">GITHUB →</a>
                </div>
              </div>
            )}
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
/* ── 友链卡片 ── */
.friend-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 14px;
}
.friend-card {
  position: relative;
  display: flex; align-items: center; gap: 14px;
  background: var(--paper-raise);
  border: 1px solid var(--rule-soft);
  border-radius: 4px;
  padding: 16px;
  transition: transform 0.2s var(--ease-out), border-color 0.2s, box-shadow 0.2s;
}
.friend-card:hover {
  transform: translateY(-3px);
  border-color: var(--ink);
  box-shadow: 0 6px 18px rgba(26, 26, 26, 0.1);
}
.friend-card-avatar {
  width: 52px; height: 52px; flex: none;
  border-radius: 4px; object-fit: cover;
  border: 1px solid var(--rule-soft);
  background: var(--paper);
}
.friend-card-body {
  display: flex; flex-direction: column; gap: 4px;
  min-width: 0; padding-right: 16px;
}
.friend-card-name {
  font-family: var(--font-grot); font-size: 15px; font-weight: 900;
  line-height: 1.35;
  color: var(--ink);
  transition: color 0.2s;
}
.friend-card:hover .friend-card-name { color: var(--c-pink); }
.friend-card-desc {
  font-family: var(--font-cn); font-size: 12.5px; line-height: 1.6;
  color: var(--muted);
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}
.friend-card-arrow {
  position: absolute; top: 12px; right: 14px;
  font-family: var(--font-mono); font-size: 13px;
  color: var(--muted);
  transition: transform 0.2s var(--ease-out), color 0.2s;
}
.friend-card:hover .friend-card-arrow {
  color: var(--ink);
  transform: translate(2px, -2px);
}

.external-group-copy {
  margin: -2px 0 14px;
  font-family: var(--font-cn);
  font-size: 14px;
  line-height: 1.8;
  color: var(--muted);
}
.exchange-rules {
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid var(--rule-soft);
}
.exchange-rules .mono-meta { display: block; margin-bottom: 10px; }
.exchange-list {
  list-style: none;
  padding: 0;
  margin: 0 0 16px;
  font-family: var(--font-cn);
  font-size: 13.5px;
  line-height: 1.8;
  color: var(--ink-soft);
}
.exchange-list li {
  padding-left: 20px;
  position: relative;
  margin-bottom: 6px;
}
.exchange-list li::before {
  content: '■';
  position: absolute;
  left: 0;
  font-size: 8px;
  top: 0.55em;
  color: var(--muted);
}
.exchange-info {
  margin-bottom: 18px;
}
.exchange-info code {
  display: block;
  margin-top: 8px;
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.7;
  color: var(--ink);
  background: var(--paper-raise);
  border: 1px solid var(--rule-soft);
  border-radius: 4px;
  padding: 10px 14px;
  overflow-x: auto;
}
.exchange-actions { display: flex; gap: 24px; flex-wrap: wrap; }
</style>
