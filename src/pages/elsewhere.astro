---
import BaseLayout from '../layouts/BaseLayout.astro';
import { elsewhereLinks, type ElsewhereKind } from '../data/elsewhere';

const groups: Array<{ kind: ElsewhereKind; label: string; title: string; copy: string }> = [
  {
    kind: 'friends',
    label: 'FRIENDS',
    title: 'FRIENDS',
    copy: '朋友们正在建造的地方。',
  },
  {
    kind: 'network',
    label: 'NETWORKS',
    title: 'NETWORKS',
    copy: '我登记入驻的博客平台与圈子，欢迎来串门。',
  },
  {
    kind: 'reading',
    label: 'READING',
    title: 'READING',
    copy: '我会反复回去看的工具、项目和资料。',
  },
];
---

<BaseLayout activeNav="elsewhere" title="Elsewhere — MODUSENSUS">
  <header class="container page-header">
    <div class="mono-label">ELSEWHERE</div>
    <h1 class="page-header-title">OTHER<br />PLACES</h1>
    <p class="page-header-subtitle">远方 — FRIENDS / NETWORKS / READING</p>
  </header>

  <div class="container board">
    <hr class="board-rule" />
    <div class="elsewhere-layout">
      <div class="elsewhere-list">
      {groups.map(group => {
        const links = elsewhereLinks.filter(link => link.kind === group.kind);
        return (
          <section class="external-group">
            <div class="mono-label group-label">{group.label}</div>
            <p class="external-group-copy">{group.copy}</p>
            {links.length > 0 && group.kind === 'friends' ? (
              <div class="friend-grid">
                {links.map((link, i) => (
                  <a
                    class="friend-card"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="ticket-face">
                      <span class="friend-card-head">
                        {link.image && (
                          <img
                            class="friend-card-avatar"
                            src={link.image}
                            alt={`${link.name} 头像`}
                            loading="eager"
                            width="42"
                            height="42"
                          />
                        )}
                        <span class="friend-card-name">{link.name}</span>
                      </span>
                      <span class="friend-card-desc">{link.description}</span>
                    </span>
                    <span class="ticket-stub">
                      <span class="friend-card-route" aria-hidden="true">FRIENDS EXPRESS</span>
                      <span class="ticket-barcode" aria-hidden="true"></span>
                      <span class="friend-card-no">NO.{String(i + 1).padStart(2, '0')}</span>
                    </span>
                  </a>
                ))}
              </div>
            ) : links.length > 0 ? (
              <div>
                {links.map(link => (
                  <a
                    class="external-row"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="external-name">{link.name}</span>
                    <span class="external-desc">{link.description}</span>
                    <span class="external-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <div class="empty-state-title">OPEN FOR EXCHANGE</div>
                <p class="empty-state-copy">友链位虚以待。欢迎交换链接，一起把小圈子连起来。</p>
              </div>
            )}
          </section>
        );
      })}
      </div>
      <aside class="apply-note">
        <span class="paperclip" aria-hidden="true"></span>
        <span class="mono-meta apply-note-title">HOW TO APPLY · 友链申请</span>
        <ul class="exchange-list">
          <li>你的站点需要正常访问，且由你长期维护</li>
          <li>先用 COPY MY INFO 一键复制本站信息加到你的友链，再按 YOUR INFO 的格式填好你的信息，通过留言板或 GitHub 发给我</li>
          <li>内容不限主题，原创优先；拒绝纯采集、挂广告弹窗或含恶意内容的站点</li>
          <li>交换后我会尽快把你的链接加进来，也会期待你把我加上 ↴</li>
        </ul>
        <div class="exchange-block">
          <div class="exchange-block-head">
            <span class="mono-meta">COPY MY INFO · 本站信息</span>
            <button class="copy-btn" type="button" data-copy-target="#copy-my-info">COPY ⧉</button>
          </div>
          <pre id="copy-my-info" class="copy-block">{`title: MODUSENSUS
description: 城市、数据与创造力的交汇处，写博客也做小工具。
website: https://modusensus.space/
image: https://modusensus.space/images/profile-avatar.jpg`}</pre>
        </div>
        <div class="exchange-block">
          <div class="exchange-block-head">
            <span class="mono-meta">YOUR INFO · 申请格式（填好发我）</span>
            <button class="copy-btn" type="button" data-copy-target="#copy-your-info">COPY ⧉</button>
          </div>
          <pre id="copy-your-info" class="copy-block">{`title: 你的站点名称
description: 一句话介绍
website: https://your-site.com/
image: https://your-site.com/avatar.jpg`}</pre>
        </div>
        <div class="exchange-actions">
          <a class="col-more" href="/guestbook">LEAVE A NOTE →</a>
          <a class="col-more" href="https://github.com/modusensus" target="_blank" rel="noopener noreferrer">GITHUB →</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // 友链信息复制按钮：事件委托绑在 document 上，一次绑定即可跨 ViewTransitions 客户端路由持续有效
  document.addEventListener('click', (e) => {
    const btn = e.target instanceof Element ? e.target.closest('[data-copy-target]') : null;
    if (!btn) return;
    const block = document.querySelector(btn.getAttribute('data-copy-target') || '');
    if (!block) return;
    const text = (block.textContent || '').trim();
    const done = () => {
      btn.textContent = 'COPIED ✓';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'COPY ⧉';
        btn.classList.remove('copied');
      }, 1600);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
    } else {
      fallbackCopy(text, done);
    }
  });

  // 剪贴板 API 不可用时的兜底（旧浏览器 / 非安全上下文）
  function fallbackCopy(text, done) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      done();
    } catch (err) {
      /* 复制失败静默忽略 */
    }
    ta.remove();
  }
</script>

<style>
/* ── 友链卡片：横版复古车票（参考票根结构）──
   外框 + 内双线框、左右撕票齿、竖直剪票孔线、右侧深色条码副券 */
.friend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}
.friend-card {
  position: relative;
  display: flex; align-items: stretch;
  background: var(--paper-raise);
  border: 1px solid var(--rule-soft);
  transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
}
.friend-card:hover {
  transform: translateY(-2px);
  box-shadow: 3px 5px 0 rgba(34, 30, 24, 0.1);
}
/* 左右撕票齿：竖排半圆缺口（露出页面纸色） */
.friend-card::before,
.friend-card::after {
  content: '';
  position: absolute;
  top: 14px; bottom: 14px;
  width: 12px;
  background: radial-gradient(circle 6px at 6px 6px, var(--paper) 6px, transparent 6px);
  background-size: 12px 12px;
  pointer-events: none;
  z-index: 1;
}
.friend-card::before { left: -6px; }
.friend-card::after { right: -6px; }

/* 主券面：内双线框 */
.ticket-face {
  flex: 1;
  min-width: 0;
  position: relative;
  display: flex; flex-direction: column; justify-content: center; gap: 8px;
  padding: 16px 18px;
  margin: 5px 0 5px 5px;
}
.ticket-face::before {
  content: '';
  position: absolute;
  inset: 0;
  border: 1px solid var(--ink-soft);
  outline: 1px solid var(--ink-soft);
  outline-offset: 2.5px;
  pointer-events: none;
  transition: border-color 0.25s var(--ease-out), outline-color 0.25s var(--ease-out);
}
.friend-card:hover .ticket-face::before {
  border-color: var(--c-pink);
  outline-color: var(--c-pink);
}
.friend-card-head {
  display: flex; align-items: center; gap: 12px;
  min-width: 0;
}
.friend-card-avatar {
  width: 42px; height: 42px; flex: none;
  border-radius: 50%; object-fit: cover;
  border: 1px solid var(--rule-soft);
  background: var(--paper);
  transition: transform 0.25s var(--ease-out);
}
.friend-card:hover .friend-card-avatar { transform: rotate(-3deg) scale(1.06); }
.friend-card-name {
  font-family: var(--font-grot); font-size: 18px; font-weight: 900;
  line-height: 1.25; letter-spacing: -0.01em;
  color: var(--ink);
  transition: color 0.25s var(--ease-out);
}
.friend-card:hover .friend-card-name { color: var(--c-pink); }
.friend-card-desc {
  font-family: var(--font-cn); font-size: 12px; line-height: 1.6;
  color: var(--muted);
}
/* 副券：深色票根 + 条码（通顶通底，撕齿咬进副券） */
.ticket-stub {
  flex: none;
  width: 58px;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  padding: 6px 0;
  background: var(--ink);
  color: var(--paper);
  border-left: 1px dashed var(--rule-soft);
  position: relative;
}
/* 剪票孔线（副券左侧一排打孔） */
.ticket-stub::before {
  content: '';
  position: absolute;
  top: 2px; bottom: 2px; left: 0;
  width: 5px;
  background: radial-gradient(circle 2.5px at 2.5px 2.5px, var(--paper-raise) 2.5px, transparent 2.5px);
  background-size: 5px 10px;
}
.friend-card-route {
  writing-mode: vertical-rl;
  font-family: var(--font-mono);
  font-size: 8px; letter-spacing: 0.2em;
  color: var(--paper);
  opacity: 0.75;
}
.ticket-barcode {
  width: 28px; height: 34px;
  background: repeating-linear-gradient(90deg,
    var(--paper) 0 1.5px, transparent 1.5px 4px,
    var(--paper) 4px 5px, transparent 5px 8px,
    var(--paper) 8px 10.5px, transparent 10.5px 12px);
}
.friend-card-no {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-size: 9.5px; letter-spacing: 0.08em;
  color: var(--paper);
}

.external-group-copy {
  margin: -2px 0 14px;
  font-family: var(--font-cn);
  font-size: 14px;
  line-height: 1.8;
  color: var(--muted);
}
/* ── 页面右侧栏：友链申请便签（回形针便签卡）── */
:root { --note-paper: #F8E9BD; }
:root[data-theme='dark'] { --note-paper: #3A3426; }
.elsewhere-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  gap: 56px;
  align-items: start;
}
.apply-note {
  position: sticky;
  top: 24px;
  padding: 20px 18px 18px;
  background: var(--note-paper);
  border: 1px solid var(--rule-soft);
  box-shadow: 3px 5px 0 rgba(34, 30, 24, 0.08);
  transform: rotate(-0.6deg);
}
.apply-note-title {
  display: block;
  padding-bottom: 10px;
  margin-bottom: 12px;
  border-bottom: 1px dashed var(--rule-soft);
}
.paperclip {
  position: absolute;
  top: -15px; left: 50%;
  transform: translateX(-50%) rotate(-28deg);
  width: 18px; height: 42px;
  border: 3px solid var(--muted);
  border-bottom: 0;
  border-radius: 50% 50% 48% 48% / 62% 62% 38% 38%;
  pointer-events: none;
}
.paperclip::after {
  content: '';
  position: absolute;
  bottom: -13px; left: 50%;
  transform: translateX(-50%);
  width: 11px; height: 16px;
  border: 3px solid var(--muted);
  border-top: 0;
  border-radius: 50% 50% 48% 48% / 30% 30% 70% 70%;
  pointer-events: none;
}
@media (max-width: 1024px) {
  .elsewhere-layout { grid-template-columns: 1fr; }
  /* 便签里的 pre 不可折行，会撑大 1fr 列导致整页横向溢出 */
  .elsewhere-layout > * { min-width: 0; }
  .apply-note { position: static; transform: none; }
  .friend-grid { grid-template-columns: 1fr; }
}
.exchange-list {
  list-style: none;
  padding: 0;
  margin: 0 0 16px;
  font-family: var(--font-cn);
  font-size: 13.5px;
  line-height: 1.8;
  color: var(--ink-soft);
}
.exchange-list li {
  padding-left: 20px;
  position: relative;
  margin-bottom: 6px;
}
.exchange-list li::before {
  content: '■';
  position: absolute;
  left: 0;
  font-size: 8px;
  top: 0.55em;
  color: var(--muted);
}
.exchange-block { margin-bottom: 14px; }
.exchange-block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}
.exchange-block-head .mono-meta { margin-bottom: 0; }
.copy-btn {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--muted);
  background: var(--paper-raise);
  border: 1px solid var(--rule-soft);
  border-radius: 4px;
  padding: 5px 12px;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s, transform 0.2s var(--ease-out);
}
.copy-btn:hover, .copy-btn.copied {
  color: var(--c-pink);
  border-color: var(--c-pink);
  transform: translateY(-1px);
}
.copy-block {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.8;
  color: var(--ink);
  background: var(--paper-raise);
  border: 1px solid var(--rule-soft);
  border-radius: 4px;
  padding: 12px 14px;
  overflow-x: auto;
  white-space: pre;
}
.exchange-actions { display: flex; gap: 24px; flex-wrap: wrap; }
</style>
