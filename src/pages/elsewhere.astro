---
import BaseLayout from '../layouts/BaseLayout.astro';
import { elsewhereLinks, type ElsewhereKind } from '../data/elsewhere';

const groups: Array<{ kind: ElsewhereKind; label: string; title: string; copy: string }> = [
  {
    kind: 'friends',
    label: 'FRIENDS',
    title: 'FRIENDS',
    copy: '朋友们正在建造的地方。',
  },
  {
    kind: 'reading',
    label: 'READING',
    title: 'READING',
    copy: '我会反复回去看的工具、项目和资料。',
  },
  {
    kind: 'community',
    label: 'COMMUNITIES',
    title: 'COMMUNITIES',
    copy: '把我挂进去的博客平台与社区。',
  },
];
---

<BaseLayout activeNav="elsewhere" title="Elsewhere — MODUSENSUS">
  <header class="container page-header">
    <div class="mono-label">ELSEWHERE</div>
    <h1 class="page-header-title">OTHER<br />PLACES</h1>
    <p class="page-header-subtitle">远方 — FRIENDS / COMMUNITIES / READING</p>
  </header>

  <div class="container board">
    <hr class="board-rule" />
    <div class="elsewhere-list">
      {groups.map(group => {
        const links = elsewhereLinks.filter(link => link.kind === group.kind);
        return (
          <section class="external-group">
            <div class="mono-label group-label">{group.label}</div>
            <p class="external-group-copy">{group.copy}</p>
            {links.length > 0 && group.kind === 'friends' ? (
              <div class="friend-grid">
                {links.map((link, i) => (
                  <a
                    class="friend-card"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="friend-card-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span class="friend-card-head">
                      {link.image && (
                        <img
                          class="friend-card-avatar"
                          src={link.image}
                          alt={`${link.name} 头像`}
                          loading="eager"
                          width="44"
                          height="44"
                        />
                      )}
                      <span class="friend-card-name">{link.name}</span>
                    </span>
                    <span class="friend-card-desc">{link.description}</span>
                    <span class="friend-card-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            ) : links.length > 0 ? (
              <div>
                {links.map(link => (
                  <a
                    class="external-row"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="external-name">{link.name}</span>
                    <span class="external-desc">{link.description}</span>
                    <span class="external-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <div class="empty-state-title">OPEN FOR EXCHANGE</div>
                <p class="empty-state-copy">友链位虚以待。欢迎交换链接，一起把小圈子连起来。</p>
              </div>
            )}
            {group.kind === 'friends' && (
              <div class="exchange-rules">
                <div class="mono-meta">HOW TO APPLY · 友链申请</div>
                <ul class="exchange-list">
                  <li>你的站点需要正常访问，且由你长期维护</li>
                  <li>先用 COPY MY INFO 一键复制本站信息加到你的友链，再按 YOUR INFO 的格式填好你的信息，通过留言板或 GitHub 发给我</li>
                  <li>内容不限主题，原创优先；拒绝纯采集、挂广告弹窗或含恶意内容的站点</li>
                  <li>交换后我会尽快把你的链接加进来，也会期待你把我加上 ↴</li>
                </ul>
                <div class="exchange-block">
                  <div class="exchange-block-head">
                    <span class="mono-meta">COPY MY INFO · 本站信息</span>
                    <button class="copy-btn" type="button" data-copy-target="#copy-my-info">COPY ⧉</button>
                  </div>
                  <pre id="copy-my-info" class="copy-block">{`title: MODUSENSUS
description: 城市、数据与创造力的交汇处，写博客也做小工具。
website: https://modusensus.space/
image: https://modusensus.space/images/profile-avatar.jpg`}</pre>
                </div>
                <div class="exchange-block">
                  <div class="exchange-block-head">
                    <span class="mono-meta">YOUR INFO · 申请格式（填好发我）</span>
                    <button class="copy-btn" type="button" data-copy-target="#copy-your-info">COPY ⧉</button>
                  </div>
                  <pre id="copy-your-info" class="copy-block">{`title: 你的站点名称
description: 一句话介绍
website: https://your-site.com/
image: https://your-site.com/avatar.jpg`}</pre>
                </div>
                <div class="exchange-actions">
                  <a class="col-more" href="/guestbook">LEAVE A NOTE →</a>
                  <a class="col-more" href="https://github.com/modusensus" target="_blank" rel="noopener noreferrer">GITHUB →</a>
                </div>
              </div>
            )}
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  // 友链信息复制按钮：事件委托绑在 document 上，一次绑定即可跨 ViewTransitions 客户端路由持续有效
  document.addEventListener('click', (e) => {
    const btn = e.target instanceof Element ? e.target.closest('[data-copy-target]') : null;
    if (!btn) return;
    const block = document.querySelector(btn.getAttribute('data-copy-target') || '');
    if (!block) return;
    const text = (block.textContent || '').trim();
    const done = () => {
      btn.textContent = 'COPIED ✓';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'COPY ⧉';
        btn.classList.remove('copied');
      }, 1600);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
    } else {
      fallbackCopy(text, done);
    }
  });

  // 剪贴板 API 不可用时的兜底（旧浏览器 / 非安全上下文）
  function fallbackCopy(text, done) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      done();
    } catch (err) {
      /* 复制失败静默忽略 */
    }
    ta.remove();
  }
</script>

<style>
/* ── 友链卡片：杂志分栏格 ──
   细线分割的单元格矩阵代替浮卡：序号 + 头像（去色，悬停恢复）+ 大字站名 + 简介 */
.friend-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 0;
  border-top: 2px solid var(--rule);
  border-left: 1px solid var(--rule-soft);
}
.friend-card {
  position: relative;
  display: flex; flex-direction: column; gap: 10px;
  padding: 18px 20px 16px;
  border-right: 1px solid var(--rule-soft);
  border-bottom: 1px solid var(--rule-soft);
  transition: background 0.25s var(--ease-out);
}
.friend-card:hover { background: var(--paper-raise); }

.friend-card-index {
  position: absolute; top: 14px; right: 16px;
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  transition: color 0.25s var(--ease-out);
}
.friend-card:hover .friend-card-index { color: var(--c-pink); }

.friend-card-head {
  display: flex; align-items: center; gap: 12px;
  min-width: 0; padding-right: 28px;
}
.friend-card-avatar {
  width: 44px; height: 44px; flex: none;
  border-radius: 0; object-fit: cover;
  border: 1px solid var(--rule-soft);
  background: var(--paper);
  transition: transform 0.25s var(--ease-out);
}
.friend-card:hover .friend-card-avatar { transform: rotate(-3deg) scale(1.06); }
.friend-card-name {
  font-family: var(--font-grot); font-size: 19px; font-weight: 900;
  line-height: 1.25; letter-spacing: -0.01em;
  color: var(--ink);
  transition: color 0.25s var(--ease-out);
}
.friend-card:hover .friend-card-name { color: var(--c-pink); }
.friend-card-desc {
  font-family: var(--font-cn); font-size: 12.5px; line-height: 1.7;
  color: var(--muted);
  padding-right: 26px;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}
.friend-card-arrow {
  position: absolute; bottom: 14px; right: 16px;
  font-family: var(--font-mono); font-size: 13px;
  color: var(--muted);
  opacity: 0;
  transform: translate(-4px, 4px);
  transition: transform 0.25s var(--ease-out), opacity 0.25s var(--ease-out), color 0.2s;
}
.friend-card:hover .friend-card-arrow {
  opacity: 1;
  color: var(--ink);
  transform: translate(0, 0);
}

.external-group-copy {
  margin: -2px 0 14px;
  font-family: var(--font-cn);
  font-size: 14px;
  line-height: 1.8;
  color: var(--muted);
}
.exchange-rules {
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid var(--rule-soft);
}
.exchange-rules .mono-meta { display: block; margin-bottom: 10px; }
.exchange-list {
  list-style: none;
  padding: 0;
  margin: 0 0 16px;
  font-family: var(--font-cn);
  font-size: 13.5px;
  line-height: 1.8;
  color: var(--ink-soft);
}
.exchange-list li {
  padding-left: 20px;
  position: relative;
  margin-bottom: 6px;
}
.exchange-list li::before {
  content: '■';
  position: absolute;
  left: 0;
  font-size: 8px;
  top: 0.55em;
  color: var(--muted);
}
.exchange-block { margin-bottom: 14px; }
.exchange-block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}
.exchange-block-head .mono-meta { margin-bottom: 0; }
.copy-btn {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--muted);
  background: var(--paper-raise);
  border: 1px solid var(--rule-soft);
  border-radius: 4px;
  padding: 5px 12px;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s, transform 0.2s var(--ease-out);
}
.copy-btn:hover, .copy-btn.copied {
  color: var(--c-pink);
  border-color: var(--c-pink);
  transform: translateY(-1px);
}
.copy-block {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.8;
  color: var(--ink);
  background: var(--paper-raise);
  border: 1px solid var(--rule-soft);
  border-radius: 4px;
  padding: 12px 14px;
  overflow-x: auto;
  white-space: pre;
}
.exchange-actions { display: flex; gap: 24px; flex-wrap: wrap; }
</style>
