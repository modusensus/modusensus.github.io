---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.module === 'archive')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function fmtYear(date: Date) {
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
}
---

<BaseLayout activeNav="archive" title="Archive — MODUSENSUS">
  <header class="container page-header">
    <div class="column-art-wrap" aria-hidden="true">
      <img class="column-art" data-art="light" src="/images/columns/archive-light.png" alt="" width="480" height="480" loading="lazy" />
      <img class="column-art" data-art="dark" src="/images/columns/archive-dark.png" alt="" width="480" height="480" loading="lazy" />
    </div>
    <div class="mono-label">03 — ARCHIVE</div>
    <h1 class="page-header-title">ARCHIVE</h1>
    <p class="page-header-subtitle">知识档案 — READING / RESEARCH / NOTES</p>
  </header>

  <div class="container board">
    <hr class="board-rule" />

    <div class="mono-label group-label">ONGOING</div>
    <div>
      <a class="lab-row" href="https://github.com/modusensus/tech-stack-map" target="_blank" rel="noopener">
        <span class="lab-year">2026</span>
        <span>
          <span class="lab-name">tech-stack-map</span><br />
          <span class="lab-desc">自学，搭建技术栈的过程。</span>
        </span>
        <span class="badge">LEARNING</span>
      </a>
    </div>

    <div class="mono-label group-label">NOTES</div>
    <div>
      {posts.map((post, idx) => (
        <a
          class="ar-item"
          href={`/blog/${post.slug}`}
          data-desc={post.data.subtitle || post.data.excerpt || ''}
          data-ai={post.data.ai ? 'ai' : undefined}
        >
          <div class="ar-meta">
            <span>No. {String(posts.length - idx).padStart(2, '0')} · {post.data.category || 'NOTE'}</span>
            <span>{fmtYear(post.data.date)}</span>
          </div>
          <div class="ar-title">{post.data.title}</div>
        </a>
      ))}
      {posts.length === 0 && <p class="mono-meta">NO ENTRIES YET.</p>}
    </div>
  </div>
</BaseLayout>
