---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.module === post.data.module)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const sectionNames: Record<string, string> = {
  threshold: 'Threshold Notes',
  lab: 'Modusensus Lab',
  archive: 'Archive',
};

const sectionLinks: Record<string, string> = {
  threshold: '/threshold-notes',
  lab: '/lab',
  archive: '/archive',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title={`${post.data.title} — MODUSENSUS`} description={post.data.subtitle || post.data.excerpt}>
  <div class="page-layout">
    <aside class="page-col-left">
      {headings.length > 0 && (
        <div class="card card-padded">
          <div class="card-label">Contents</div>
          {headings.filter(h => h.depth <= 2).map(h => (
            <a href={`#${h.slug}`} class="toc-item" style="display: block;">{h.text}</a>
          ))}
        </div>
      )}
      <div class="card card-padded">
        <div class="card-label">Back to</div>
        <a href={sectionLinks[post.data.module]} class="card-list-item" style="display: block;">← {sectionNames[post.data.module]}</a>
        <a href="/blog" class="card-list-item" style="display: block;">← All Publications</a>
      </div>
    </aside>

    <article class="page-col-main">
      <div class="article-detail">
        <div class="article-detail-header">{sectionNames[post.data.module].toUpperCase()} · NO.{post.data.issue || '01'}</div>
        <h1 class="article-detail-title">{post.data.title}</h1>
        <div class="article-detail-byline">
          {formatDate(post.data.date)}
          {post.data.readingTime && ` · ${post.data.readingTime} min read`}
        </div>
        <div class="article-meta-bar">
          <span class="meta-view">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
            <span id="busuanzi_value_page_pv">0</span> views
          </span>
          <button id="like-btn" class="like-btn" type="button" data-slug={post.slug}>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
            <span id="like-count">0</span>
          </button>
        </div>
        {post.data.cover && (
          <img src={post.data.cover} alt={post.data.title} class="article-detail-cover" />
        )}
        <div class="prose">
          <Content />
        </div>
      </div>
    </article>

    <aside class="page-col-right">
      {related.length > 0 && (
        <div class="card card-padded">
          <div class="card-label">More from {sectionNames[post.data.module]}</div>
          {related.map(post => (
            <div class="news-item">
              <a href={`/blog/${post.slug}`}>
                <div class="news-title">{post.data.title}</div>
                <div class="news-meta">{formatDate(post.data.date).toUpperCase()}</div>
              </a>
            </div>
          ))}
        </div>
      )}
    </aside>
  </div>
</BaseLayout>

<script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
<script>
  // 点赞：localStorage 本地记录
  const likeBtn = document.getElementById('like-btn');
  if (likeBtn) {
    const slug = likeBtn.dataset.slug;
    const key = 'modusensus_like_' + slug;
    let state = JSON.parse(localStorage.getItem(key) || '{"liked":false,"count":0}');
    const countEl = document.getElementById('like-count');

    const render = () => {
      countEl.textContent = state.count;
      likeBtn.classList.toggle('liked', state.liked);
    };

    likeBtn.addEventListener('click', () => {
      state.liked = !state.liked;
      state.count += state.liked ? 1 : -1;
      localStorage.setItem(key, JSON.stringify(state));
      render();
    });

    render();
  }
</script>
