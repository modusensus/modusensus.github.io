---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// 概要（TL;DR）：优先 frontmatter abstract，否则回落到 excerpt
const abstract = post.data.abstract || post.data.excerpt;

const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.module === post.data.module)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const sectionNames: Record<string, string> = {
  threshold: 'THRESHOLD NOTES',
  lab: 'MODUSENSUS LAB',
  archive: 'ARCHIVE',
};
const sectionLinks: Record<string, string> = {
  threshold: '/threshold-notes',
  lab: '/lab',
  archive: '/archive',
};
const activeNavMap: Record<string, 'threshold' | 'lab' | 'archive'> = {
  threshold: 'threshold',
  lab: 'lab',
  archive: 'archive',
};

function fmtLong(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
}

const tocItems = headings.filter(h => h.depth === 2);
---

<BaseLayout
  title={`${post.data.title} — MODUSENSUS`}
  description={post.data.subtitle || post.data.excerpt}
  activeNav={activeNavMap[post.data.module]}
>
  <article class="container">
    <div class="article">
      <header>
        <div class="mono-label art-label">
          {sectionNames[post.data.module]}{post.data.issue ? ` · NO.${post.data.issue}` : ''}
        </div>
        <h1 class="art-title">{post.data.title}</h1>
        {post.data.subtitle && <p class="art-subtitle">{post.data.subtitle}</p>}
        <div class="art-meta-line">
          <span class="mono-meta">{fmtLong(post.data.date)}</span>
          {post.data.readingTime && <span class="mono-meta">{post.data.readingTime} MIN READ</span>}
          <span class="mono-meta"><span class="waline-pageview-count" data-path={`/blog/${post.slug}`}>–</span> VIEWS</span>
        </div>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="art-tags">
            {post.data.tags.map(t => <span class="art-tag">#{t}</span>)}
          </div>
        )}
      </header>

      {abstract && (
        <section class="art-abstract" aria-label="文章概要">
          <div class="art-abstract-label">TL;DR · 概要</div>
          <p class="art-abstract-text">{abstract}</p>
        </section>
      )}

      {post.data.cover && (
        <figure class="art-cover">
          <img src={post.data.cover} alt={post.data.title} loading="eager" />
          <figcaption class="mono-meta">COVER · {post.data.category ?? 'IMAGE'}</figcaption>
        </figure>
      )}

      {tocItems.length > 0 && (
        <details class="toc" open>
          <summary>CONTENTS · {tocItems.length} 节</summary>
          <nav>
            {tocItems.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        </details>
      )}

      <div class="prose">
        <Content />
      </div>

      <div class="art-actions">
        <div class="art-back">
          <a href={sectionLinks[post.data.module]}>← {sectionNames[post.data.module]}</a>
          <a href="/blog">← ALL</a>
        </div>
        <button id="like-btn" class="like-btn" type="button" data-slug={post.slug}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
          <span id="like-count">0</span>
        </button>
      </div>

      <div class="comments">
        <div class="mono-label comments-label">COMMENTS · 说点什么</div>
        <div class="waline" data-waline-path={`/blog/${post.slug}`} aria-label="文章评论"></div>
      </div>
    </div>

    {related.length > 0 && (
      <div class="related">
        <div class="mono-label group-label">MORE FROM {sectionNames[post.data.module]}</div>
        <div>
          {related.map(rel => (
            <a class="ar-item" href={`/blog/${rel.slug}`}>
              <div class="ar-meta">
                <span>{rel.data.issue ? `NO.${rel.data.issue}` : sectionNames[rel.data.module]}</span>
                <span>{fmtLong(rel.data.date)}</span>
              </div>
              <div class="ar-title">{rel.data.title}</div>
              {rel.data.tags && rel.data.tags.length > 0 && (
                <div class="ar-tags">
                  {rel.data.tags.map(t => <span class="ar-tag">#{t}</span>)}
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    )}
  </article>

  {tocItems.length > 0 && (
    <aside class="art-sidebar" id="art-sidebar" aria-label="阅读进度与目录">
      <div class="art-sidebar-progress">
        <span class="mono-meta">READING</span>
        <span class="art-sidebar-num" id="sidebar-progress-num">0%</span>
      </div>
      <div class="art-sidebar-bar"><i id="sidebar-progress-fill"></i></div>
      <div class="mono-label art-sidebar-toc-label">CONTENTS</div>
      <nav class="art-toc">
        {tocItems.map(h => <a class="art-toc-link" href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
    </aside>
  )}
</BaseLayout>

<script data-astro-rerun>
  // ── 代码块增强：给 .prose 内每个 <pre> 套一层 .code-wrap（position:relative），
  //    右上角放复制按钮。按钮锚定包装层而非 pre 本身，代码横向滚动时不跟着移出视野。
  //    data-astro-rerun：路由切换后脚本随新 DOM 重新执行，正文每次到达文章页都会被包装；
  //    已包装的 pre 会被跳过，不会重复挂按钮 ──
  (function enhanceCodeBlocks() {
    var ICON_COPY = '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    var ICON_DONE = '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>';

    var pres = document.querySelectorAll('.prose pre');
    for (var p = 0; p < pres.length; p++) {
      var pre = pres[p];
      if (pre.parentElement && pre.parentElement.classList.contains('code-wrap')) continue;

      var wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      // 语言标签移到包装层（CSS ::after 读 attr(data-language)），避免与按钮重叠定位
      var lang = pre.getAttribute('data-language');
      if (lang) { wrap.setAttribute('data-language', lang); pre.removeAttribute('data-language'); }
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.setAttribute('aria-label', '复制代码');
      btn.title = '复制代码';
      btn.innerHTML = ICON_COPY;
      wrap.appendChild(btn);

      btn.addEventListener('click', function (code, button) {
        return function () {
          var text = code.innerText;
          var done = function () {
            button.classList.add('copied');
            button.innerHTML = ICON_DONE;
            button.setAttribute('aria-label', '已复制');
            setTimeout(function () {
              button.classList.remove('copied');
              button.innerHTML = ICON_COPY;
              button.setAttribute('aria-label', '复制代码');
            }, 1600);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text, done); });
          } else {
            fallbackCopy(text, done);
          }
        };
      }(pre.querySelector('code') || pre, btn));
    }

    // http 环境下 navigator.clipboard 不可用（仅安全上下文），用隐藏 textarea 兜底
    function fallbackCopy(text, done) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch (e) { /* 静默失败 */ }
      document.body.removeChild(ta);
    }
  })();

  // ── 阅读进度条（纯 JS：data-astro-rerun 脚本不经编译，不能使用 TS 语法） ──
  var progress = document.getElementById('reading-progress');
  function onScroll() {
    if (!progress) return;
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    progress.style.width = max > 0 ? (h.scrollTop / max) * 100 + '%' : '0%';
  }
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ── 点赞（全站累计：Upstash KV + cookie 去重；API 不可用时退回本地计数） ──
  var likeBtn = document.getElementById('like-btn');
  if (likeBtn) {
    var slug = likeBtn.dataset.slug || '';
    var key = 'modusensus_like_' + slug;
    var state = JSON.parse(localStorage.getItem(key) || '{"liked":false}');
    var countEl = document.getElementById('like-count');
    var count = 0;
    var serverLive = false;

    var renderLike = function () {
      countEl.textContent = String(count);
      likeBtn.classList.toggle('liked', state.liked);
    };

    var applyCount = function (n) {
      count = Math.max(0, Math.round(Number(n) || 0));
      renderLike();
    };

    fetch('/api/like?slug=' + encodeURIComponent(slug), { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (d && typeof d.likes === 'number') {
          serverLive = true;
          applyCount(d.likes);
        }
      })
      .catch(function () { /* API 不可用：保持本地计数 */ });

    likeBtn.addEventListener('click', function () {
      var next = !state.liked;
      var delta = next ? 1 : -1;
      state.liked = next;
      count += delta; // 乐观更新，等服务端确认
      localStorage.setItem(key, JSON.stringify(state));
      renderLike();
      if (!serverLive) return; // API 不可用时纯本地
      fetch('/api/like', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: slug, liked: next }),
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (d && typeof d.likes === 'number') applyCount(d.likes);
        })
        .catch(function () {
          // 同步失败：回滚本地状态与计数
          state.liked = !next;
          count -= delta;
          localStorage.setItem(key, JSON.stringify(state));
          renderLike();
        });
    });

    renderLike();
  }

  // ── 侧边栏：阅读百分比 + 目录 scrollspy（纯 JS） ──
  var sidebar = document.getElementById('art-sidebar');
  if (sidebar) {
    var numEl = document.getElementById('sidebar-progress-num');
    var fillEl = document.getElementById('sidebar-progress-fill');
    var tocLinks = sidebar.querySelectorAll('.art-toc-link');
    var tocItems = [];
    for (var i = 0; i < tocLinks.length; i++) {
      var hid = tocLinks[i].getAttribute('href').slice(1);
      var hel = document.getElementById(hid);
      if (hel) tocItems.push({ link: tocLinks[i], el: hel });
    }
    var activeIdx = -1;
    var syncSidebar = function () {
      var de = document.documentElement;
      var max = de.scrollHeight - de.clientHeight;
      var pct = max > 0 ? Math.round((de.scrollTop / max) * 100) : 0;
      pct = Math.max(0, Math.min(100, pct));
      if (numEl) numEl.textContent = pct + '%';
      if (fillEl) fillEl.style.width = pct + '%';
      var line = window.innerHeight * 0.35;
      var idx = -1;
      for (var j = 0; j < tocItems.length; j++) {
        if (tocItems[j].el.getBoundingClientRect().top <= line) idx = j;
      }
      if (idx !== activeIdx) {
        activeIdx = idx;
        for (var k = 0; k < tocItems.length; k++) {
          tocItems[k].link.classList.toggle('active', k === idx);
        }
      }
    };
    document.addEventListener('scroll', syncSidebar, { passive: true });
    window.addEventListener('resize', syncSidebar);
    syncSidebar();
  }
</script>

<!-- Waline 浏览量统计脚本已上移到 BaseLayout（全局一份，避免双份导致重复计数） -->

<style>
.comments {
  margin-top: 64px;
  padding-top: 44px;
  border-top: 1px solid var(--rule);
}
.comments-label { color: var(--ink); margin-bottom: 30px; }
</style>

<script>
  // ── 文章页 Waline 评论区（主题覆盖在 global.css，与留言板同一套）；
  //    data-waline-path 与页首浏览量的 data-path 保持一致（/blog/slug）。
  //    右上角读者入口弹窗登录成功后会广播 modusensus:waline-user，
  //    这里销毁重建评论框以读取最新登录态 ──
  import { init } from '@waline/client';
  import '@waline/client/style';
  import { serverURL } from '../../config/waline.json';

  let walineInstance = null;

  function mountComments() {
    if (walineInstance) {
      try { walineInstance.destroy(); } catch { /* 已销毁 */ }
      walineInstance = null;
      // destroy 会清空 .waline 内部 DOM；若不清除挂载标志，下次 mount 会被
      // dataset.walineMounted 挡住而跳过重新 init，评论区就永久空白（登录后必现）
      const prev = document.querySelector('.waline[data-waline-path]');
      if (prev) delete prev.dataset.walineMounted;
    }
    const mount = document.querySelector('.waline[data-waline-path]');
    if (!mount) return;
    // 防御：挂载标志若是别的页面脚本留下的（挂载路径与当前页不符），清掉重新挂，
    // 避免文章评论区被错误初始化成其他路径（如留言板的 /guestbook）
    const mountPath = (mount.dataset.walinePath || '').replace(/\/$/, '');
    if (mount.dataset.walineMounted && mountPath && mountPath !== location.pathname.replace(/\/$/, '')) {
      delete mount.dataset.walineMounted;
    }
    if (mount.dataset.walineMounted) return;
    mount.dataset.walineMounted = 'true'; // 同一 DOM 只挂载一次，防止重复 init
    walineInstance = init({
      el: mount,
      serverURL,
      lang: 'zh-CN',
      // 传 CSS 选择器而非 'auto'：跟随站点 data-theme 切换，主题按钮点击即时生效
      dark: ":root[data-theme='dark']",
      meta: ['nick', 'mail', 'link'],
      requiredMeta: ['nick', 'mail'],
      search: false,
      pageSize: 10,
      path: mount.dataset.walinePath,
    });
  }

  document.addEventListener('modusensus:waline-user', mountComments);
  document.addEventListener('astro:page-load', mountComments);
</script>
