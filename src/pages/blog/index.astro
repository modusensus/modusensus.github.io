---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sectionNames: Record<string, string> = {
  threshold: 'Threshold Notes',
  lab: 'Modusensus Lab',
  archive: 'Archive',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).replace(/\//g, '.');
}

const years = [...new Set(posts.map(p => p.data.date.getFullYear()))].sort((a, b) => b - a);
---

<BaseLayout title="All Publications — MODUSENSUS">
  <header class="page-header">
    <h1 class="page-header-title">ALL PUBLICATIONS</h1>
    <p class="page-header-subtitle">Complete archive of all essays, lab logs and notes.</p>
  </header>

  <div class="page-layout">
    <aside class="page-col-left">
      <div class="card card-padded">
        <div class="card-label">Filter</div>
        <a href="/blog" class="card-list-item" style="display: block; color: var(--ink); font-weight: 600;">All publications</a>
        <a href="/threshold-notes" class="card-list-item" style="display: block;">Threshold Notes</a>
        <a href="/lab" class="card-list-item" style="display: block;">Modusensus Lab</a>
        <a href="/archive" class="card-list-item" style="display: block;">Archive</a>
      </div>
      <div class="card card-padded">
        <div class="card-label">Stats</div>
        <div class="card-stat-row"><span>Total</span><span>{posts.length}</span></div>
      </div>
    </aside>

    <section class="page-col-main">
      {posts.map((post, idx) => (
        <a href={`/blog/${post.slug}`} class="list-card">
          <div>
            <div class="list-card-title">{post.data.title}</div>
            <div class="list-card-meta">{formatDate(post.data.date)} · {sectionNames[post.data.module].toUpperCase()} · NO.{post.data.issue || String(idx + 1).padStart(2, '0')}</div>
          </div>
          <div class="list-card-num">{String(idx + 1).padStart(2, '0')}</div>
        </a>
      ))}
    </section>

    <aside class="page-col-right">
      <div class="card card-padded">
        <div class="card-label">Browse by year</div>
        {years.map(year => (
          <div class="card-list-item">{year}</div>
        ))}
      </div>
    </aside>
  </div>
</BaseLayout>
