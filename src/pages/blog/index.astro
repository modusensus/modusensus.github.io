---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sectionNames: Record<string, string> = {
  threshold: 'THRESHOLD',
  lab: 'LAB',
  archive: 'ARCHIVE',
};

function fmtYear(date: Date) {
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
}

const years = [...new Set(posts.map(p => p.data.date.getFullYear()))].sort((a, b) => b - a);
---

<BaseLayout activeNav="home" title="All Publications — MODUSENSUS">
  <header class="container page-header">
    <div class="mono-label">INDEX</div>
    <h1 class="page-header-title">ALL<br />PUBLICATIONS</h1>
    <p class="page-header-subtitle">COMPLETE ARCHIVE — {posts.length} ENTRIES</p>
  </header>

  <div class="container board">
    <hr class="board-rule" />
    {years.map(year => (
      <section>
        <div class="mono-label group-label">{year}</div>
        <div>
          {posts.filter(p => p.data.date.getFullYear() === year).map(post => (
            <a class="ar-item" href={`/blog/${post.slug}`}>
              <div class="ar-meta">
                <span>{sectionNames[post.data.module]}{post.data.issue ? ` · NO.${post.data.issue}` : ''}</span>
                <span>{fmtYear(post.data.date)}</span>
              </div>
              <div class="ar-title">{post.data.title}</div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
