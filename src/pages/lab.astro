---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const labPosts = allPosts.filter(p => p.data.module === 'lab');
const fieldworkCount = labPosts.filter(p => p.data.group === 'fieldwork').length;
const logCount = labPosts.filter(p => p.data.group !== 'fieldwork').length;

const cards = [
  {
    key: 'fieldwork',
    label: '01 — FIELDWORK',
    title: '空间研究',
    note: '用数据与地图读城市',
    count: `${String(fieldworkCount).padStart(2, '0')} ENTRIES`,
    href: '/lab/fieldwork',
    image: '/images/lab/demeter-cover.jpg',
    deity: 'Demeter',
  },
  {
    key: 'logs',
    label: '02 — LOGS',
    title: '开发日志',
    note: '从想法到上线',
    count: `${String(logCount).padStart(2, '0')} ENTRIES`,
    href: '/lab/logs',
    image: '/images/lab/hermes-cover.jpg',
    deity: 'Hermes',
  },
  {
    key: 'builds',
    label: '03 — BUILDS',
    title: '开源项目',
    note: '发布在 GitHub 的作品',
    count: '05 PROJECTS',
    href: '/lab/builds',
    image: '/images/lab/hephaestus-cover.jpg',
    deity: 'Hephaestus',
  },
];
---

<BaseLayout activeNav="lab" title="Modusensus Lab — MODUSENSUS">
  <header class="container page-header">
    <div class="column-art-wrap" aria-hidden="true">
      <img class="column-art" data-art="light" src="/images/columns/lab-light.png" alt="" width="480" height="480" loading="lazy" />
      <img class="column-art" data-art="dark" src="/images/columns/lab-dark.png" alt="" width="480" height="480" loading="lazy" />
    </div>
    <div class="mono-label">02 — LAB</div>
    <h1 class="page-header-title">LAB</h1>
    <p class="page-header-subtitle">工作室 — AI EXPERIMENTS · TOOLS · SPATIAL RESEARCH · SYSTEMS</p>
  </header>

  <div class="container board">
    <hr class="board-rule" />

    <div class="lab-cards">
      {cards.map((card, idx) => (
        <a class="lab-card" href={card.href} data-section={card.key}>
          <div class={`card-image-wrap ${card.key === 'builds' ? 'builds-image' : ''}`}>
            <img src={card.image} alt={`${card.deity} sculpture`} width="480" height="480" loading={idx === 0 ? 'eager' : 'lazy'} />
          </div>
          <div class="card-body">
            <div class="card-meta">
              <span class="card-label">{card.label}</span>
              <span class="card-count">{card.count}</span>
            </div>
            <h2 class="card-title">{card.title}</h2>
            <p class="card-note">{card.note}</p>
            <span class="card-cta">
              <span>进入专栏</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  /* ── 三张专栏卡片：桌面三列，平板两列，手机一列 ── */
  .lab-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    padding: 8px 0 40px;
    max-width: 780px;
    margin: 0 auto;
  }

  .lab-card {
    display: flex;
    flex-direction: column;
    background: transparent;
    border: none;
    border-radius: 0;
    overflow: visible;
    text-decoration: none;
    transition: transform 0.35s var(--ease-out);
  }
  .lab-card:hover {
    transform: translateY(-4px);
  }

  .card-image-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #E8E3D8;
  }
  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    transition: transform 0.7s var(--ease-out);
  }
  .card-image-wrap.builds-image img {
    object-position: center 78%;
  }
  .lab-card:hover .card-image-wrap img {
    transform: scale(1.05);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px 0 0;
    flex: 1;
    border-top: none;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-count {
    color: var(--ink-soft);
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    margin: 0;
    position: relative;
    display: inline-block;
  }
  .card-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 1px;
    width: 0;
    height: 1px;
    background: var(--c-pink);
    transition: width 0.35s var(--ease-out);
  }
  .lab-card:hover .card-title::after {
    width: 100%;
  }

  .card-note {
    font-family: var(--font-cn);
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: gap 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .lab-card:hover .card-cta {
    gap: 12px;
    color: var(--c-pink);
  }

  /* ── 响应式 ── */
  @media (max-width: 1040px) {
    .lab-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 680px) {
    .lab-cards {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .card-title {
      font-size: 22px;
    }
  }
</style>
