---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.module === 'lab')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = [
  { name: 'Nest',       year: '2026', badge: 'AI/APP',  desc: '对话驱动的个人 AI 工作台。聊天即可管理项目、任务、习惯、文章，React + FastAPI + SQLite，支持 Function Calling 与记忆库。', link: 'https://github.com/modusensus/nest' },
  { name: 'dsh-mneme',  year: '2026', badge: 'MEMORY',  desc: 'The memory that dreams — self-evolving memory for DeepSeek Harness: your AI remembers across sessions, consolidates in its sleep, forgets what matters less, and grows smarter over time. Fully offline & private.', link: 'https://github.com/modusensus/dsh-mneme' },
  { name: 'CaseForge',  year: '2026', badge: 'LLM',     desc: '学术论文深度拆解框架。8 字段结构化提取 + 4 格式输出。', link: 'https://github.com/modusensus/CaseForge' },
  { name: 'MindOS',     year: '2026', badge: 'WIDGET',  desc: 'AI 驱动的个人成长系统。8 模块单文件 HTML Widget。', link: 'https://github.com/modusensus/Mindos' },
  { name: 'Ponte',      year: '2026', badge: 'CLI',     desc: 'Persistent SSH reverse tunnel daemon CLI. Auto-reconnect with exponential backoff + jitter.', link: 'https://github.com/modusensus/ponte' },
];

function fmtShort(date: Date) {
  const m = date.toLocaleDateString('en-US', { month: 'short' });
  return `${m}. ${String(date.getDate()).padStart(2, '0')}`;
}
---

<BaseLayout activeNav="lab" title="Modusensus Lab — MODUSENSUS">
  <header class="container page-header">
    <div class="mono-label">01 — BUILDS</div>
    <h1 class="page-header-title">MODUSENSUS<br />LAB</h1>
    <p class="page-header-subtitle">AI EXPERIMENTS · TOOLS · AUTOMATION · SYSTEMS</p>
  </header>

  <div class="container board">
    <hr class="board-rule" />

    <div class="mono-label group-label">BUILDS</div>
    <div>
      {projects.map(p => (
        <a class="lab-row" href={p.link} target="_blank" rel="noopener">
          <span class="lab-year">{p.year}</span>
          <span>
            <span class="lab-name">{p.name}</span><br />
            <span class="lab-desc">{p.desc}</span>
          </span>
          <span class="badge">{p.badge}</span>
        </a>
      ))}
    </div>

    <div class="mono-label group-label">LOGS</div>
    <div>
      {posts.map((post, idx) => (
        <a class="ar-item" href={`/blog/${post.slug}`}>
          <div class="ar-meta">
            <span>LOG — {String(posts.length - idx).padStart(2, '0')}</span>
            <span>{fmtShort(post.data.date)}</span>
          </div>
          <div class="ar-title">{post.data.title}</div>
        </a>
      ))}
      {posts.length === 0 && <p class="mono-meta">NO LOGS YET.</p>}
    </div>
  </div>
</BaseLayout>
