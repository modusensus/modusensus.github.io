---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout activeNav="colophon" title="Colophon — MODUSENSUS">
  <header class="page-header">
    <h1 class="page-header-title">COLOPHON</h1>
    <p class="page-header-subtitle">About MODUSENSUS</p>
  </header>

  <div class="page-layout">
    <aside class="page-col-left">
      <div class="card card-padded">
        <div class="card-label">Subscribe</div>
        <p style="font-size: 11px; color: var(--dust); line-height: 1.6; margin-bottom: 10px;">Get notified when new articles are published.</p>
        <form action="/rss.xml" method="get" style="display: flex; flex-direction: column; gap: 8px;">
          <input type="email" placeholder="your@email.com" style="width: 100%; padding: 8px; border: 1px solid var(--border-strong); border-radius: 4px; font-size: 11px;" />
          <button type="submit" style="width: 100%; padding: 8px; background: var(--ink); color: #fff; border: none; border-radius: 4px; font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer;">Subscribe</button>
        </form>
      </div>
      <div class="card card-padded">
        <div class="card-label">Contact</div>
        <a href="https://github.com/modusensus" class="card-list-item" style="display: block;">GitHub</a>
        <a href="mailto:hello@modusensus.com" class="card-list-item" style="display: block;">Email</a>
        <a href="/rss.xml" class="card-list-item" style="display: block;">RSS</a>
      </div>
    </aside>

    <section class="page-col-main">
      <div class="card card-padded" style="margin-bottom: 16px;">
        <div class="card-label">01 — Studio</div>
        <p style="font-family: var(--font-body); font-size: 15px; line-height: 1.85; color: #333; margin-bottom: 12px;">MODUSENSUS 是一个长期运营的数字思想工作室。</p>
        <p style="font-family: var(--font-body); font-size: 15px; line-height: 1.85; color: #333;"><strong>Modus</strong>：方式、方法、模式。<br><strong>Sensus</strong>：感知、理解、意义。</p>
      </div>

      <div class="card card-padded" style="margin-bottom: 16px;">
        <div class="card-label">02 — Typography</div>
        <div class="info-row">
          <span style="color: var(--dust);">Display</span>
          <span style="font-family: var(--font-display); color: var(--ink);">Space Grotesk</span>
        </div>
        <div class="info-row">
          <span style="color: var(--dust);">Body</span>
          <span style="font-family: var(--font-body); color: var(--ink);">Noto Serif SC</span>
        </div>
        <div class="info-row">
          <span style="color: var(--dust);">UI</span>
          <span style="font-family: var(--font-ui); color: var(--ink);">Inter</span>
        </div>
      </div>

      <div class="card card-padded">
        <div class="card-label">03 — Principles</div>
        <p style="font-family: var(--font-body); font-size: 15px; line-height: 1.85; color: #333;">以慢思考对抗信息过载，以清晰结构承载复杂议题。关注城市、技术与人的交叉地带。</p>
      </div>
    </section>

    <aside class="page-col-right">
      <div class="card card-padded">
        <div class="card-label">Tech Stack</div>
        <div>
          <span class="pill">Astro</span>
          <span class="pill">Markdown</span>
          <span class="pill">GitHub Pages</span>
          <span class="pill">Python</span>
          <span class="pill">Obsidian</span>
        </div>
      </div>
      <div class="card card-padded">
        <div class="card-label">Research Interests</div>
        <div style="font-size: 11px; color: var(--dust); line-height: 1.7;">
          <div>空间公平与城市可达性</div>
          <div>数字治理与 AI 政策</div>
          <div>人机协作与自动化工作流</div>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
