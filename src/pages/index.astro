---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const thresholdPosts = sortedPosts.filter(p => p.data.module === 'threshold');
const labPosts = sortedPosts.filter(p => p.data.module === 'lab');
const archivePosts = sortedPosts.filter(p => p.data.module === 'archive');

const latestPost = sortedPosts[0];

const sectionColors: Record<string, string> = {
  threshold: 'threshold-gradient',
  lab: 'lab-gradient',
  archive: 'archive-gradient',
};

const sectionNames: Record<string, string> = {
  threshold: 'Threshold Notes',
  lab: 'Modusensus Lab',
  archive: 'Archive',
};

const sectionDesc: Record<string, string> = {
  threshold: '数字思想杂志',
  lab: 'AI experiments',
  archive: '知识档案',
};

const sectionAbbr: Record<string, string> = {
  threshold: 'TN',
  lab: 'LB',
  archive: 'AR',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout activeNav="home">
  <div class="page-layout">
    <!-- Left: Profile -->
    <aside class="page-col-left">
      <div class="card profile-card">
        <div class="profile-banner" style="background-image: url('/images/profile-banner.jpg'); background-size: cover; background-position: center;"></div>
        <div class="profile-avatar-wrap"><img src="/images/profile-avatar.jpg" alt="MODUSENSUS avatar" /></div>
        <div style="padding: 0 16px 12px;">
          <div class="profile-name">MODUSENSUS</div>
          <div class="profile-headline">Independent Digital Studio</div>
        </div>
        <p class="profile-signature">关注城市、数据与创造力的交汇处，在这里记录学习的轨迹。</p>
        <div class="card-divider"></div>
        <div style="padding: 10px 16px; text-align: left;">
          <div class="card-stat-row"><span>Articles</span><span>{allPosts.length}</span></div>
          <div class="card-stat-row"><span>Projects</span><span>2</span></div>
        </div>
        <div class="card-divider"></div>
        <div style="padding: 10px 16px; text-align: left;">
          <div style="font-size: 10px; color: var(--ink); font-weight: 600; margin-bottom: 6px;">Sections</div>
          <a href="/threshold-notes" class="card-list-item" style="display: block;">Threshold Notes</a>
          <a href="/lab" class="card-list-item" style="display: block;">Modusensus Lab</a>
          <a href="/archive" class="card-list-item" style="display: block;">Archive</a>
          <a href="/colophon" class="card-list-item" style="display: block;">Colophon</a>
        </div>
      </div>
    </aside>

    <!-- Main: Write + Feed -->
    <section class="page-col-main">
      <a href="/write" class="write-box">
        <div class="write-avatar"><img src="/images/profile-avatar.jpg" alt="avatar" /></div>
        <div class="write-input">Write a new article...</div>
      </a>

      {sortedPosts.map((post, idx) => (
        <article class="article-feed-card">
          <a href={`/blog/${post.slug}`} style="display: block;">
            <div class="article-feed-header">
              <div class="feed-avatar">{sectionAbbr[post.data.module]}</div>
              <div>
                <div class="feed-meta-name">{sectionNames[post.data.module]}</div>
                <div class="feed-meta-date">{formatDate(post.data.date)}</div>
              </div>
            </div>
            <div class="feed-body">
              <h3 class="feed-title">{post.data.title}</h3>
              <p class="feed-excerpt">{post.data.subtitle || post.data.excerpt || ''}</p>
            </div>
            {post.data.cover ? (
              <img src={post.data.cover} alt={post.data.title} class="feed-cover" />
            ) : (
              <div class={`feed-cover-placeholder ${sectionColors[post.data.module]}`}></div>
            )}
            <div class="feed-footer">
              <span class="feed-read-btn">→ Read</span>
              <span class="feed-tag">#{post.data.module}</span>
            </div>
          </a>
        </article>
      ))}
    </section>

    <!-- Right: Explore + What's new -->
    <aside class="page-col-right">
      <div class="card card-padded">
        <div class="card-label">Explore sections</div>
        <div class="section-item">
          <div class="section-avatar">TN</div>
          <div>
            <div class="section-name">Threshold Notes</div>
            <div class="section-desc">数字思想杂志</div>
            <a href="/threshold-notes"><button class="browse-btn">Browse →</button></a>
          </div>
        </div>
        <div class="section-item">
          <div class="section-avatar">LB</div>
          <div>
            <div class="section-name">Modusensus Lab</div>
            <div class="section-desc">AI experiments</div>
            <a href="/lab"><button class="browse-btn">Browse →</button></a>
          </div>
        </div>
        <div class="section-item" style="margin-bottom: 0;">
          <div class="section-avatar">AR</div>
          <div>
            <div class="section-name">Archive</div>
            <div class="section-desc">知识档案</div>
            <a href="/archive"><button class="browse-btn">Browse →</button></a>
          </div>
        </div>
      </div>

      {latestPost && (
        <div class="card card-padded">
          <div class="card-label">What's new</div>
          <div class="news-item">
            <a href={`/blog/${latestPost.slug}`}>
              <div class="news-title">{latestPost.data.title}</div>
              <div class="news-meta">{formatDate(latestPost.data.date).toUpperCase()} · {sectionNames[latestPost.data.module].toUpperCase()}</div>
            </a>
          </div>
        </div>
      )}
    </aside>
  </div>
</BaseLayout>
