---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionGrid from '../components/SectionGrid.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const thresholdPosts = sortedPosts.filter(p => p.data.module === 'threshold');
const labPosts = sortedPosts.filter(p => p.data.module === 'lab');
const archivePosts = sortedPosts.filter(p => p.data.module === 'archive');

const latestPost = sortedPosts[0];

const sectionColors: Record<string, string> = {
  threshold: 'threshold-gradient',
  lab: 'lab-gradient',
  archive: 'archive-gradient',
};

const sectionNames: Record<string, string> = {
  threshold: 'Threshold Notes',
  lab: 'Modusensus Lab',
  archive: 'Archive',
};

const sectionDesc: Record<string, string> = {
  threshold: '数字思想杂志',
  lab: 'AI experiments',
  archive: '知识档案',
};

const sectionAbbr: Record<string, string> = {
  threshold: 'TN',
  lab: 'LB',
  archive: 'AR',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// ── 右侧栏日历卡片：构建时按当月生成 ──
const calNow = new Date();
const calYear = calNow.getFullYear();
const calMonth = calNow.toLocaleDateString('en-US', { month: 'long' });
const calFirstDow = new Date(calYear, calNow.getMonth(), 1).getDay();
const calDays = new Date(calYear, calNow.getMonth() + 1, 0).getDate();
const calToday = calNow.getDate();
const calWeek = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const calEmpty = Array.from({ length: calFirstDow });
const calDayCells = Array.from({ length: calDays }, (_, i) => i + 1);
---

<BaseLayout activeNav="home" showHero>
  <div class="page-layout">
    <!-- Left: Profile -->
    <aside class="page-col-left">
      <div class="card profile-card">
        <div class="profile-avatar-wrap"><img src="/images/profile-avatar.gif" alt="MODUSENSUS avatar" /></div>
        <div style="padding: 0 16px 4px;">
          <div class="profile-name"><span class="typewriter-text" aria-live="polite"></span><span class="blink-caret" aria-hidden="true"></span></div>
          <div class="profile-headline">Independent Digital Studio</div>
        </div>
        <div class="profile-links">
          <a href="https://github.com/modusensus" class="profile-link" title="GitHub" aria-label="GitHub">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <a href="mailto:hello@modusensus.com" class="profile-link" title="Email" aria-label="Email">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1.5" y="2.5" width="13" height="11" rx="1"/><path d="M2 4l6 5 6-5"/></svg>
          </a>
          <a href="/rss.xml" class="profile-link" title="RSS" aria-label="RSS">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor"><path d="M2 13.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3z"/><path d="M2 8a6 6 0 016 6H6a4 4 0 00-4-4V8z"/><path d="M2 2a12 12 0 0112 12h-2a10 10 0 00-10-10V2z"/></svg>
          </a>
        </div>
        <p class="profile-signature">关注城市、数据与创造力的交汇处，在这里记录学习的轨迹。</p>
        <div class="card-divider"></div>
        <div style="padding: 10px 16px; text-align: left;">
          <div class="card-stat-row"><span>Articles</span><span>{allPosts.length}</span></div>
          <div class="card-stat-row"><span>Projects</span><span>2</span></div>
        </div>
        <div class="card-divider"></div>
        <div style="padding: 10px 16px; text-align: left;">
          <div style="font-size: 10px; color: var(--ink); font-weight: 600; margin-bottom: 6px;">Sections</div>
          <a href="/threshold-notes" class="card-list-item" style="display: block;">Threshold Notes</a>
          <a href="/lab" class="card-list-item" style="display: block;">Modusensus Lab</a>
          <a href="/archive" class="card-list-item" style="display: block;">Archive</a>
          <a href="/colophon" class="card-list-item" style="display: block;">Colophon</a>
        </div>
      </div>
    </aside>

    <!-- Main: Timeline + Cards -->
    <section class="page-col-main">
      <div class="timeline">
        {sortedPosts.map((post, idx) => (
          <a href={`/blog/${post.slug}`} class="timeline-card">
            <div class="timeline-rail">
              <span class="timeline-num">{String(sortedPosts.length - idx).padStart(2, '0')}</span>
            </div>
            <article class="timeline-body">
              <div class="timeline-head">
                <div class="timeline-meta">
                  <span class={`tag tag-${post.data.module}`}>{sectionNames[post.data.module]}</span>
                  <span class="timeline-date">{formatDate(post.data.date)}</span>
                </div>
                <h3 class="feed-title">{post.data.title}</h3>
              </div>
              <div class="timeline-main">
                <div class="timeline-cover-wrap">
                  {post.data.cover ? (
                    <img src={post.data.cover} alt={post.data.title} class="timeline-cover" />
                  ) : (
                    <div class={`timeline-cover timeline-placeholder ${sectionColors[post.data.module]}`}></div>
                  )}
                </div>
                <div class="timeline-content">
                  <p class="feed-excerpt">{post.data.subtitle || post.data.excerpt || ''}</p>
                  <div class="timeline-foot">
                    <span class="feed-read-btn">→ Read</span>
                    <span class="feed-tag">#{post.data.module}</span>
                  </div>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </section>

    <!-- Right: Explore + What's new + Calendar -->
    <aside class="page-col-right">
      <SectionGrid />

      {latestPost && (
        <div class="card card-padded">
          <div class="card-label">What's new</div>
          <div class="news-item">
            <a href={`/blog/${latestPost.slug}`}>
              <div class="news-title">{latestPost.data.title}</div>
              <div class="news-meta">{formatDate(latestPost.data.date).toUpperCase()} · {sectionNames[latestPost.data.module].toUpperCase()}</div>
            </a>
          </div>
        </div>
      )}

      <div class="card card-padded calendar-card">
        <div class="card-label">Calendar</div>
        <div class="cal-head">
          <span class="cal-month">{calMonth}</span>
          <span class="cal-year">{calYear}</span>
        </div>
        <div class="cal-grid">
          {calWeek.map(d => <span class="cal-dow">{d}</span>)}
          {calEmpty.map(() => <span class="cal-empty"></span>)}
          {calDayCells.map(d => (
            <span class:list={['cal-day', { 'cal-today': d === calToday }]}>{d}</span>
          ))}
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
/* ── Timeline: 时间轴 + 卡片（封面在左、文字在右） ── */
.timeline {
  position: relative;
  display: flex;
  flex-direction: column;
}
/* 贯穿整列的时间轴竖线（静态可见） */
.timeline::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 27px;
  width: 1px;
  background: var(--border-strong);
}
/* 时间轴竖线上的流动光点：沿竖线循环下移 */
.timeline::after {
  content: '';
  position: absolute;
  left: 25px;
  top: 0;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 6px var(--accent);
  z-index: 2;
  animation: ms-flow 5s linear infinite;
}
@keyframes ms-flow {
  0%   { top: 0; opacity: 0; }
  5%   { opacity: 0.9; }
  95%  { opacity: 0.9; }
  100% { top: 100%; opacity: 0; }
}

.timeline-card {
  position: relative;
  display: grid;
  grid-template-columns: 54px 1fr;
  gap: 16px;
  margin-bottom: 16px;
  text-decoration: none;
  color: inherit;
}
.timeline-card:last-child { margin-bottom: 0; }

/* 左侧序号节点列 */
.timeline-rail {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 0;
  position: relative;
  z-index: 1;
}
/* 序号圆点：顶部对齐卡片 */
.timeline-num {
  position: relative;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--paper);
  border: 1px solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-ui);
  font-size: 10px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.04em;
}
/* 序号圆点外圈呼吸脉冲 */
.timeline-num::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1px solid var(--accent);
  animation: ms-pulse 2.6s ease-in-out infinite;
}
@keyframes ms-pulse {
  0%, 100% { transform: scale(1); opacity: 0.35; }
  50%      { transform: scale(1.35); opacity: 0.08; }
}
/* 右侧卡片：标题/刊号在上，封面在左、文字在右 —— 长矩形，整体更紧凑 */
.timeline-body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: var(--paper);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px;
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}
/* 卡片顶部：刊号 + 日期 + 标题 */
.timeline-head {
  padding: 0 2px;
}
/* 卡片下部：左封面、右文字 */
.timeline-main {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 14px;
  align-items: center;
}
/* 序号右侧延伸的横线：紧贴卡片上沿 */
.timeline-body::before {
  content: '';
  position: absolute;
  top: 16px;
  right: 100%;
  width: 27px;
  height: 1px;
  background: var(--border-strong);
}
.timeline-card:hover .timeline-body {
  transform: translateY(-2px) scale(1.01);
  box-shadow: 0 6px 18px rgba(26, 26, 26, 0.08);
  border-color: var(--ink);
}

.timeline-cover-wrap {
  position: relative;
  height: 136px;
  min-height: 136px;
  border-radius: 4px;
  overflow: hidden;
  background: var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.timeline-cover-wrap img,
.timeline-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
}
.timeline-placeholder { display: block; width: 100%; height: 100%; }

/* 内容区（右侧） */
.timeline-content {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 0;
}
.timeline-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 7px;
}
.timeline-date {
  font-family: var(--font-ui);
  font-size: 10px;
  letter-spacing: 0.08em;
  color: var(--dust);
  text-transform: uppercase;
}

/* 标题：Libre Baskerville + 霞鹜文楷，文艺编辑感 */
.timeline-card .feed-title {
  font-family: 'Libre Baskerville', 'LXGW WenKai', 'Noto Serif SC', serif;
  font-size: 19px;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 7px;
  position: relative;
  animation: none;
  letter-spacing: 0.01em;
}
/* 选中（hover）标题下划线浮现动效 */
.timeline-card .feed-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 0;
  height: 1px;
  background: var(--ink);
  transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}
.timeline-card:hover .feed-title::after {
  width: 100%;
}

.feed-excerpt {
  font-family: 'Crimson Text', 'LXGW WenKai', 'Noto Serif SC', serif;
  font-size: 13px;
  line-height: 1.75;
  color: var(--dust);
  margin-bottom: 10px;
  flex: 1;
}

/* 卡片下部：Crimson Text 斜体，文艺杂志感 */
.timeline-foot {
  display: flex;
  gap: 16px;
  align-items: baseline;
  padding-top: 8px;
  border-top: 1px solid var(--border);
  font-family: 'Crimson Text', 'LXGW WenKai', 'Noto Serif SC', serif;
  font-style: italic;
  font-size: 12px;
}
.feed-read-btn { font-weight: 600; color: var(--accent); }
.feed-tag { color: var(--dust); }

/* 触屏设备禁用悬浮位移 */
@media (hover: none) {
  .timeline-card:hover .timeline-body {
    transform: none;
    box-shadow: none;
  }
}

/* ── 右侧栏 What's new ── */
.news-item { margin-bottom: 12px; }
.news-title {
  font-family: var(--font-serif);
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}
.news-meta {
  font-family: var(--font-ui);
  font-size: 9px;
  color: var(--dust);
  margin-top: 4px;
  letter-spacing: 0.06em;
}

/* ── 右侧栏：日历卡片 ── */
.calendar-card { margin-top: 8px; }
.cal-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 8px;
  margin-bottom: 8px;
  border-bottom: 1px solid var(--border);
}
.cal-month {
  font-family: var(--font-serif);
  font-size: 18px;
  font-weight: 600;
  color: var(--ink);
}
.cal-year {
  font-family: var(--font-ui);
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--dust);
}
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2px;
  text-align: center;
}
.cal-dow {
  font-family: var(--font-ui);
  font-size: 9px;
  font-weight: 700;
  color: var(--dust);
  padding: 4px 0;
  letter-spacing: 0.05em;
}
.cal-empty { padding: 4px 0; }
.cal-day {
  font-family: var(--font-ui);
  font-size: 11px;
  color: var(--ink);
  padding: 5px 0;
  border-radius: 2px;
}
.cal-today {
  background: var(--accent);
  color: #fff;
  font-weight: 700;
}

/* 编辑杂志式闪烁光标 */
.blink-caret {
  display: inline-block;
  width: 1px;
  height: 1em;
  margin-left: 4px;
  vertical-align: -0.15em;
  background: var(--accent);
  animation: ms-blink 1.1s steps(1) infinite;
}
@keyframes ms-blink {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0; }
}

/* 打字机文字：等宽占位避免居中抖动 */
.typewriter-text {
  font-variant-numeric: tabular-nums;
}

/* 移动端：封面缩小、卡片保持上下结构 */
@media (max-width: 640px) {
  .timeline-main {
    grid-template-columns: 118px 1fr;
    gap: 12px;
  }
  .timeline-cover-wrap { height: 118px; min-height: 118px; }
  .timeline-card .feed-title { font-size: 17px; }
  .feed-excerpt { font-size: 12px; }
}
</style>

<script>
// ── 左侧名字打字机：打字 → 停顿 → 删除 → 再打（循环） ──
function initTypewriter() {
  const el = document.querySelector('.profile-name .typewriter-text');
  if (!el) return;

  const text = 'MODUSENSUS';
  const typeSpeed = 150;   // 打字每字间隔
  const deleteSpeed = 80;  // 删除每字间隔
  const hold = 2000;       // 打满 / 删除完后的停顿

  // 尊重系统“减少动态效果”设置
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    el.textContent = text;
    return;
  }

  let index = 0;
  let deleting = false;

  function tick() {
    if (!deleting) {
      el.textContent = text.slice(0, ++index);
      if (index === text.length) { deleting = true; setTimeout(tick, hold); return; }
      setTimeout(tick, typeSpeed);
    } else {
      el.textContent = text.slice(0, --index);
      if (index === 0) { deleting = false; setTimeout(tick, hold); return; }
      setTimeout(tick, deleteSpeed);
    }
  }
  tick();
}
document.addEventListener('astro:after-swap', initTypewriter);
initTypewriter();
</script>
