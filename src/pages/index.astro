---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { announcements } from '../data/announcements';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recent = sorted.slice(0, 3);

// 站点统计（构建时统计）：文章数 + 正文字数（剥去代码块/行内代码/标记符号后计字符）
const siteStats = allPosts.reduce(
  (acc, p) => {
    acc.posts += 1;
    acc.words += (p.body || '')
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/`[^`]*`/g, ' ')
      .replace(/[[\]()*_>#~|-]/g, ' ')
      .replace(/\s+/g, '').length;
    return acc;
  },
  { posts: 0, words: 0 },
);
const SITE_EST = '2026-07-14'; // 仓库首个提交日 = 站点运行起点

const moduleNames: Record<string, string> = {
  threshold: 'THRESHOLD',
  lab: 'LAB',
  archive: 'ARCHIVE',
};

// 文章 tag：优先 frontmatter 的 tags 数组，缺失时按 category 的 / 拆分兜底
function postTags(p: { data: { tags?: string[]; category?: string } }): string[] {
  return p.data.tags || (p.data.category || '').split('/').map((c) => c.trim()).filter(Boolean);
}

// 分区（SECTIONS）：按 module 聚合，标出该分区用到的全部 tag 与一句话概括
const sectionIntro: Record<string, string> = {
  threshold: '思想随笔与长期观察——关于城市、媒介与自我的慢思考。',
  lab: '动手实验的完整记录：空间研究、数据可视化、小工具与构建日志。',
  archive: '知识档案与方法存档——可复现的流程、踩坑笔记与技术细节。',
};
const sections = ['threshold', 'lab', 'archive'].map((m) => {
  const posts = sorted.filter((p) => p.data.module === m);
  const tags = [...new Set(posts.flatMap((p) => postTags(p)))];
  return {
    key: m,
    name: moduleNames[m],
    desc: sectionIntro[m],
    href: m === 'threshold' ? '/threshold-notes' : `/${m}`,
    count: posts.length,
    tags,
  };
});

const letters = 'MODUSENSUS'.split('');
const letterColors = ['orange', 'yellow', 'purple', 'green', 'pink', 'blue'];
const cardColors = ['var(--c-pink)', 'var(--c-blue)', 'var(--c-yellow)'];

function fmtYear(date: Date) {
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
}
