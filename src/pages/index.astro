      </div>
      <div class="doodle d-float d2" style="bottom:36%; left:36%; --r:-4deg;">
        <svg width="46" height="46" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="14" r="7"/><path d="M9.8 13a3 3 0 014.4 0" stroke-linecap="round"/><path d="M20 22l6 5M23 20l4 6" stroke-linecap="round"/></svg>
      </div>

      <div class="doodle d-float d3" style="top:30%; left:14%; --r:6deg;">
