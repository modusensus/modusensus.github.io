      </div>
      <div class="doodle d-float d2" style="top:42%; left:12%; --r:-5deg;">
        <svg width="26" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M17 9a5 5 0 0 0-9.9-1A4.5 4.5 0 0 0 7.5 17H17a4 4 0 0 0 0-8z" stroke-linejoin="round"/><path d="M10 7.5l2.2-2M8 9.5L5.5 8.5M7 12.5H4.5" stroke-linecap="round"/></svg>
      </div>
      <div class="doodle d-float" style="top:50%; left:21%; --r:4deg;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M6 19V6.5L17 3v13" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="19" r="2.2"/><circle cx="17" cy="16" r="2.2"/><path d="M8.2 18.3L15.2 14.5" stroke-linecap="round"/></svg>
      </div>

      <div class="hero-foot">
        <span>INDEPENDENT DIGITAL STUDIO — 城市 · 数据 · 创造力</span>
        <span class="scroll">SCROLL ↓</span>
      </div>
    </section>
  </Fragment>

  <!-- ═══ 主页正文（封面之后的世界）：顶部切入跑马灯 + 分区面板 ═══ -->
  <!-- ── 切入横条：纸底跑马灯（两份相同内容实现无缝循环） ── -->
  <div class="hero-ticker" aria-hidden="true">
    <div class="hero-ticker-track">
      <span>MODUSENSUS — INDEPENDENT DIGITAL STUDIO — 城市 · 数据 · 创造力 — STUDIO / THRESHOLD NOTES / LAB / ARCHIVE — EST. 2025 —&nbsp;</span>
      <span>MODUSENSUS — INDEPENDENT DIGITAL STUDIO — 城市 · 数据 · 创造力 — STUDIO / THRESHOLD NOTES / LAB / ARCHIVE — EST. 2025 —&nbsp;</span>
    </div>
  </div>

  <!-- ═══ SITE PANEL — 站点统计 + 分区 + 时间轴 + 公告 + 留言 ═══ -->
  <div class="container board">

    <!-- 01 站点统计（左）+ 02 分区（右） -->
    <div class="stats-row">

      <section class="stats-band">
        <div class="section-head">
          <span class="mono-label">01 — SITE STATS</span>
          <span class="col-sub">站点统计</span>
        </div>
        <div class="stats-grid">
          <div class="stat">
            <div class="stat-num">{siteStats.posts}</div>
            <div class="stat-label">POSTS · 文章</div>
          </div>
          <div class="stat">
            <div class="stat-num">{siteStats.words.toLocaleString('en-US')}</div>
            <div class="stat-label">WORDS · 总字数</div>
          </div>
          <div class="stat">
            <div class="stat-num" id="stat-days">&ndash;</div>
            <div class="stat-label">DAYS · 运行天数</div>
          </div>
        </div>
      </section>

      <section class="sections-card">
        <div class="section-head">
          <span class="mono-label">02 — SECTIONS</span>
          <span class="col-sub">分区</span>
        </div>
        <div class="sections-list">
          {sections.map(s => (
            <a class="sections-item" href={s.href}>
              <div class="sections-item-head">
                <span class="sections-name">{s.name}</span>
                <span class="sections-count">{s.count} POSTS</span>
              </div>
              <p class="sections-desc">{s.desc}</p>
              <div class="sections-tags">
                {s.tags.map(t => <span class="sections-tag">{t}</span>)}
              </div>
            </a>
          ))}
        </div>
      </section>

    </div>

    <!-- 03 公告：回形针夹着的明信片 -->
    <section class="announce-band">
      <div class="section-head">
        <span class="mono-label">03 — ANNOUNCEMENTS</span>
        <span class="col-sub">公告</span>
      </div>
      <div class="announce-cards">
        {announcements.map((a, i) => (
          <div class="announce-card" style={`--card-accent: ${cardColors[i % cardColors.length]}`}>
            <span class="announce-clip" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.5 5.5 8.5 11.5a3 3 0 0 0 0 4.2l1.8 1.8a3 3 0 0 0 4.2 0l6-6a4.5 4.5 0 0 0-6.4-6.4l-7 7a6 6 0 0 0 8.5 8.5l5.5-5.5"/></svg>
            </span>
            <div class="announce-card-top">
              <span class="announce-tag">NOTICE</span>
              <span class="mono-meta">{a.date}</span>
            </div>
            <p class="announce-text">{a.text}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="home-grid">

      <!-- 04 近期更新：时间轴 -->
      <section class="home-main">
        <div class="section-head">
          <span class="mono-label">04 — RECENT UPDATES</span>
          <span class="col-sub">近期更新</span>
        </div>
        <div class="timeline">
          {recent.map(post => (
            <a class="tl-item" href={`/blog/${post.slug}`}>
              <span class="tl-node" aria-hidden="true"></span>
              <div class="tl-meta">
                <span class="mono-meta">{fmtYear(post.data.date)} — {moduleNames[post.data.module]}{post.data.issue ? ` · NO.${post.data.issue}` : ''}</span>
              </div>
              <div class="tl-title">{post.data.title}</div>
              {post.data.subtitle && <div class="tl-desc">{post.data.subtitle}</div>}
              {postTags(post).length > 0 && (
                <div class="tl-tags">
                  {postTags(post).map(t => <span class="tl-tag">#{t}</span>)}
                </div>
              )}
            </a>
          ))}
        </div>
        <a class="col-more" href="/blog">ALL POSTS →</a>
      </section>

      <!-- 右栏：留言 -->
      <aside class="home-rail">
        <div class="rail-card">
          <div class="section-head">
            <span class="mono-label">05 — READERS' LETTERS</span>
            <span class="col-sub">读者来信</span>
          </div>
          <p class="announce-text">来自文章评论与留言板的读者来信，点链接回到原文一起聊。</p>
          <!-- 读者来信：Waline recent API 拉全站最新评论（文章评论 + 留言板），取不到/为空时保持隐藏 -->
          <div class="rc-list rc-list--letters" id="home-latest-comments" hidden></div>
          <a class="col-more" href="/guestbook">SIGN THE BOOK →</a>
        </div>
      </aside>

    </div>
  </div>
</BaseLayout>

<style>
/* ═══ 封面（COVER）═══
   无 JS：普通文档流首屏，照常向下滚动（渐进增强兜底）。
   JS 可用：升级为全屏固定层（z 205 盖过导航 z200 / 读者签 z195 / 状态件 z190），
   与下方主页互相独立；html.cover-mode 锁滚动，下滑渐变切入主页。 */
.hero {
  position: relative;
  min-height: 100vh;
  background: var(--hero-bg);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  overflow: hidden;
  z-index: 205;
}
:global(html.js) .hero { position: fixed; inset: 0; min-height: 0; }
:global(html.cover-mode) { overflow: hidden; }
.hero::before {
  content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 1;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 240 240' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' seed='7' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: 0.16; mix-blend-mode: overlay;
}
.hero-inner {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center;
  padding: 0 24px;
}

/* 头像贴纸 */
.hero-avatar {
  width: 112px; height: 112px;
  object-fit: cover;
  border-radius: 50%;
  border: 3px solid var(--hero-fg);
  box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.45);
  transform: rotate(-6deg);
  margin-bottom: 26px;
}

.hero-script {
  font-family: var(--font-script); font-weight: 700;
  font-size: clamp(30px, 4.2vw, 56px);
  color: var(--c-pink);
  transform: rotate(-3deg);
  margin-bottom: 0.35em;
}

/* 彩色拆字 */
.hero-word {
  display: flex; align-items: baseline; flex-wrap: wrap; justify-content: center;
  font-family: var(--font-grot); font-weight: 900;
  font-size: clamp(44px, 8.6vw, 132px);
  line-height: 1; letter-spacing: -0.01em;
  user-select: none;
}
.hero-word span {
  display: inline-block;
  -webkit-text-stroke: 2px #1A1A1A;
  text-shadow: 0.045em 0.045em 0 var(--c-green), 0.09em 0.09em 0 #1A1A1A;
  transition: transform 0.3s var(--ease-out);
}
.hero-word span:nth-child(odd)  { rotate: -4deg; }
.hero-word span:nth-child(even) { rotate: 3deg; translate: 0 -0.03em; }
.hero-word span:hover { transform: translateY(-0.06em) scale(1.07); }

.lc-orange { color: var(--c-orange); }
.lc-yellow { color: var(--c-yellow); text-shadow: 0.045em 0.045em 0 var(--c-purple), 0.09em 0.09em 0 #1A1A1A; }
.lc-purple { color: var(--c-purple); text-shadow: 0.045em 0.045em 0 var(--c-yellow), 0.09em 0.09em 0 #1A1A1A; }
.lc-green  { color: var(--c-green);  text-shadow: 0.045em 0.045em 0 var(--c-yellow), 0.09em 0.09em 0 #1A1A1A; }
.lc-pink   { color: var(--c-pink);   text-shadow: 0.045em 0.045em 0 var(--c-blue), 0.09em 0.09em 0 #1A1A1A; }
.lc-blue   { color: var(--c-blue);   text-shadow: 0.045em 0.045em 0 var(--c-pink), 0.09em 0.09em 0 #1A1A1A; }

/* doodles */
.doodle { position: absolute; z-index: 2; color: var(--hero-fg); opacity: 0.92; }
.doodle svg { display: block; }
.d-float { animation: dfloat 5s ease-in-out infinite; }
.d-float.d2 { animation-delay: -1.6s; }
.d-float.d3 { animation-delay: -3.2s; }
@keyframes dfloat {
  0%, 100% { translate: 0 0; }
  50%      { translate: 0 -10px; }
}

.hero-foot {
  position: absolute; bottom: 34px; left: 0; right: 0; z-index: 2;
  display: flex; flex-direction: column; align-items: center; gap: 14px;
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.22em;
  color: rgba(244, 244, 242, 0.65); text-transform: uppercase;
}
.hero-foot .scroll { animation: nudge 2.2s ease-in-out infinite; cursor: pointer; }
@keyframes nudge { 0%, 100% { translate: 0 0; } 50% { translate: 0 5px; } }

.hero-entry-arrow { display: inline-block; transition: transform 0.2s var(--ease-out); }

/* 主页双入口卡片 */
.hero-entries {
  display: flex; gap: 14px; margin-top: 32px;
}
.hero-entry {
  display: flex; flex-direction: column; align-items: center; gap: 5px;
  min-width: 132px; padding: 13px 22px 12px;
  border: 1px solid rgba(244, 244, 242, 0.4); border-radius: 10px;
  color: var(--hero-fg);
  transition: border-color 0.2s, transform 0.25s var(--ease-out);
}
.hero-entry:hover { border-color: var(--c-pink); transform: translateY(-3px); }
.hero-entry:hover .hero-entry-arrow { transform: translateX(-3px); }
.hero-entry-label {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-grot); font-weight: 900; font-size: 15px;
  letter-spacing: 0.08em;
}
.hero-entry-desc {
  font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.14em;
  color: rgba(244, 244, 242, 0.6); text-transform: uppercase;
}

/* 社交图标行 */
.hero-icons {
  display: flex; gap: 13px; margin-top: 28px;
}
.hero-icons a {
  display: inline-flex; align-items: center; justify-content: center;
  width: 38px; height: 38px;
  border: 1px solid rgba(244, 244, 242, 0.4); border-radius: 999px;
  color: var(--hero-fg);
  transition: color 0.2s, background 0.2s, border-color 0.2s, transform 0.25s var(--ease-out);
}
.hero-icons a:hover {
  color: #1A1A1A; background: var(--hero-fg); border-color: var(--hero-fg);
  transform: translateY(-3px);
}

/* ═══ SITE PANEL ═══ */
/* 分隔线由 hero-ticker 的下边框承担，正文区补足上留白 */
.board { padding-top: 64px; }
.home-grid {
  display: grid; grid-template-columns: 1.6fr 1fr;
  gap: 72px; align-items: start;
}
.section-head {
  display: flex; align-items: baseline; gap: 14px;
  margin-bottom: 30px;
}
.section-head .col-sub { margin-bottom: 0; }

/* 时间轴 */
.timeline {
  position: relative;
  padding-left: 28px;
}
.timeline::before {
  content: '';
  position: absolute; left: 5px; top: 10px; bottom: 10px;
  width: 1px; background: var(--rule-soft);
}
.tl-item {
  position: relative;
  display: block;
  padding: 24px 0;
}
.tl-item + .tl-item { border-top: 1px solid transparent; }
.tl-node {
  position: absolute; left: -28px; top: 32px;
  width: 11px; height: 11px;
  border-radius: 50%;
  background: var(--paper);
  border: 2px solid var(--ink);
  transition: background 0.2s, border-color 0.2s, transform 0.25s var(--ease-out);
}
.tl-item:hover .tl-node {
  background: var(--c-pink);
  border-color: var(--c-pink);
  transform: scale(1.25);
}
.tl-meta { margin-bottom: 9px; }
.tl-title {
  font-family: var(--font-grot); font-weight: 700; font-size: 19px;
  line-height: 1.35; letter-spacing: -0.01em;
  position: relative; display: inline-block;
}
.tl-title::after {
  content: '';
  position: absolute; left: 0; bottom: -3px;
  width: 0; height: 2px;
  background: var(--ink);
  transition: width 0.35s var(--ease-out);
}
.tl-item:hover .tl-title::after { width: 100%; }
.tl-desc {
  font-family: var(--font-cn); font-size: 13.5px; line-height: 1.75;
  color: var(--muted); margin-top: 8px;
}
.tl-tags {
  display: flex; flex-wrap: wrap; gap: 10px;
  margin-top: 10px;
}
.tl-tag {
  font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
  letter-spacing: 0.12em; color: var(--muted);
  transition: color 0.2s var(--ease-out);
}
.tl-item:hover .tl-tag { color: var(--c-pink); }

.rail-card { border-top: 2px solid var(--rule); padding-top: 16px; }

/* 03 — 公告：回形针夹着的明信片（整条横带，卡面微倾 + 顶边回形针） */
.announce-band {
  border-top: 2px solid var(--rule);
  padding-top: 16px;
  margin-bottom: 64px;
}
.announce-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 22px;
}
.announce-card {
  position: relative;
  background: var(--paper-raise);
  border: 1px solid var(--rule-soft);
  padding: 16px 18px 14px;
  box-shadow: 0 2px 0 rgba(26, 26, 26, 0.04);
  transform: rotate(var(--tilt, 0deg));
  transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out), border-color 0.25s;
}
.announce-card:nth-child(odd)  { --tilt: -0.6deg; }
.announce-card:nth-child(even) { --tilt: 0.7deg; }
.announce-card:hover {
  transform: rotate(0deg) translateY(-3px);
  box-shadow: 0 8px 20px rgba(26, 26, 26, 0.1);
  border-color: var(--card-accent, var(--ink));
}
/* 回形针：金属色线夹，挂在卡片顶边中央，略微歪斜 */
.announce-clip {
  position: absolute; top: -16px; left: 50%; translate: -50% 0;
  width: 30px; height: 38px;
  color: #9a9a95;
  rotate: -6deg;
  filter: drop-shadow(0 1px 1px rgba(26, 26, 26, 0.18));
  z-index: 2; pointer-events: none;
}
.announce-clip svg { width: 100%; height: 100%; display: block; }
.announce-card-top {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 8px;
}
/* NOTICE 贴纸：描边小方戳，微斜像邮票 */
.announce-tag {
  font-family: var(--font-mono); font-size: 9px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--card-accent, var(--ink));
  border: 1px solid var(--card-accent, var(--ink));
  padding: 3px 8px;
  rotate: 2.5deg;
}
.announce-text {
  font-family: var(--font-cn); font-size: 13.5px; line-height: 1.75;
  color: var(--ink-soft); margin-bottom: 0;
}

/* 01 — 站点统计（左）+ 02 — 分区（右）：两列并排 */
.stats-row {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 72px; align-items: center;
  margin-bottom: 64px;
}
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
.stat { padding: 4px 28px 0; }
.stat:first-child { padding-left: 0; }
.stat + .stat { border-left: 1px solid var(--rule-soft); }
.stat-num {
  font-family: var(--font-grot); font-weight: 900;
  font-size: clamp(28px, 4vw, 46px); line-height: 1.05;
  letter-spacing: -0.015em;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--muted); margin-top: 10px;
}
@media (max-width: 640px) {
  .stat { padding: 4px 14px 0; }
  .stat:first-child { padding-left: 0; }
}

/* 02 — 分区：三个模块的入口卡片，每卡标出该分区用到的 tag */
.sections-card { border-top: 2px solid var(--rule); padding-top: 16px; }
.sections-item {
  display: block;
  padding: 15px 0 14px;
  border-bottom: 1px solid var(--rule-soft);
  transition: transform 0.25s var(--ease-out);
}
.sections-item:hover { transform: translateX(4px); }
.sections-item-head {
  display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
}
.sections-name {
  font-family: var(--font-grot); font-weight: 700; font-size: 17px;
  letter-spacing: -0.01em; color: var(--ink);
  transition: color 0.2s var(--ease-out);
}
.sections-item:hover .sections-name { color: var(--c-pink); }
.sections-desc {
  font-family: var(--font-cn); font-size: 12.5px; line-height: 1.75;
  color: var(--muted); margin-top: 6px;
}
.sections-count {
  font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
  letter-spacing: 0.14em; color: var(--muted); white-space: nowrap;
}
.sections-tags {
  display: flex; flex-wrap: wrap; gap: 6px;
  margin-top: 10px;
}
.sections-tag {
  font-family: var(--font-mono); font-size: 9px; font-weight: 700;
  letter-spacing: 0.12em; color: var(--muted);
  border: 1px solid var(--rule);
  padding: 2px 7px;
  transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
}
.sections-item:hover .sections-tag { border-color: var(--c-pink); color: var(--c-pink); }

/* ── 开场切入横条：纸底跑马灯，把深色开场与纸色正文明确切开 ── */
.hero-ticker {
  overflow: hidden;
  background: var(--paper);
  border-top: 2px solid var(--rule);
  border-bottom: 2px solid var(--rule);
  padding: 13px 0;
}
.hero-ticker-track {
  display: flex; width: max-content;
  animation: hero-ticker 28s linear infinite;
}
.hero-ticker-track span {
  font-family: var(--font-mono); font-size: 12px; font-weight: 700;
  letter-spacing: 0.18em; text-transform: uppercase; white-space: nowrap;
  color: var(--ink);
}
@keyframes hero-ticker {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ═══ Scroll reveal（html.js 才隐藏，无 JS 时内容照常显示） ═══ */
html.js .rv {
  opacity: 0; transform: translateY(26px);
  transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  transition-delay: var(--rv-delay, 0ms);
}
html.js .rv.rv-visible { opacity: 1; transform: none; }

/* 时间轴竖线：从上往下生长 */
html.js .timeline::before {
  transform: scaleY(0); transform-origin: top;
  transition: transform 1s var(--ease-out) 0.15s;
}
html.js .timeline.tl-draw::before { transform: scaleY(1); }

@media (max-width: 1024px) {
  .home-grid { grid-template-columns: 1fr; gap: 48px; }
  .stats-row { grid-template-columns: 1fr; gap: 48px; align-items: start; }
}
@media (max-width: 899px) {
  .hero-avatar { width: 92px; height: 92px; }
  .hero-icons { margin-top: 24px; gap: 10px; }
  .hero-icons a { width: 34px; height: 34px; }
}
@media (prefers-reduced-motion: reduce) {
  .d-float, .hero-foot .scroll { animation: none; }
  .hero-ticker-track { animation: none; }
  html.js .rv { opacity: 1; transform: none; transition: none; }
  html.js .timeline::before { transform: none; transition: none; }
}
</style>

<script>
import gsap from 'gsap';
import { serverURL } from '../config/waline.json';
import { fetchRecentComments, renderRecentList } from '../lib/recent-comments';

// ── 封面 ↔ 主页双态（模块级，跨路由切换存活）──
let splashCleanup = null; // 当前封面态的事件清理器
let splashGoCover = null; // 「渐变回封面」入口，供品牌链接点击调用
let splashEnterBoard = null; // 「切入主页正文」入口，供 HOME 链接同页跳转调用
let skipCoverFlag = false; // 点导航 HOME 跳回首页时置位：到达后直达主页正文，不落封面
let splashMode = 'cover'; // cover = 封面层显示；board = 主页正文

// 站点启用了 <ViewTransitions />：打包脚本一次完整加载只执行一次，客户端路由回首页不会重跑，
// 因此全部 DOM 初始化放进 astro:page-load（首次加载与每次路由切换后都会触发）
document.addEventListener('astro:page-load', () => {
const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// ── 封面态初始化：每次到达 / 都从封面开始；下滑（滚轮/触摸/按键）渐变切入主页，
//    正文态向上滚不会回到封面；只有点击左上角 MODUSENSUS 品牌链接才回封面 ──
if (splashCleanup) { splashCleanup(); splashCleanup = null; }
const cover = document.getElementById('cover');
const pageOffset = document.querySelector('.page-offset') as HTMLElement | null;
if (cover && pageOffset) {
  const enterBoard = () => {
    if (splashMode !== 'cover') return;
    splashMode = 'board';
    document.documentElement.classList.remove('cover-mode');
    pageOffset.inert = false;
    if (reduce) { cover.style.display = 'none'; return; }
    // 封面上移淡出 + 正文自下方渐显（交叉渐变）
    gsap.timeline()
      .to(cover, { autoAlpha: 0, y: -40, duration: 0.55, ease: 'power2.in' })
      .fromTo(pageOffset,
        { autoAlpha: 0, y: 26 },
        { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out', clearProps: 'all' },
        0.12)
      .set(cover, { display: 'none' });
  };

  const enterCover = () => {
    if (splashMode !== 'board') return;
    splashMode = 'cover';
    cover.style.display = '';
    gsap.set(cover, { clearProps: 'all' });
    window.scrollTo(0, 0);
    document.documentElement.classList.add('cover-mode');
    pageOffset.inert = true;
    if (reduce) return;
    gsap.fromTo(cover, { autoAlpha: 0, y: -30 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power2.out', clearProps: 'transform' });
  };
  splashGoCover = enterCover;
  splashEnterBoard = enterBoard;

  // 点导航 HOME 跳回首页：直接进主页正文，不落封面（保持 ViewTransitions 带来的滚动位置）
  if (skipCoverFlag) {
    skipCoverFlag = false;
    splashMode = 'board';
    cover.style.display = 'none';
  } else {
    splashMode = 'cover';
    document.documentElement.classList.add('cover-mode');
    pageOffset.inert = true; // 封面态下正文不参与焦点与读屏
    window.scrollTo(0, 0);
  }

  const onWheel = e => { if (splashMode === 'cover' && e.deltaY > 8) enterBoard(); };
  const onKey = e => {
    if (splashMode !== 'cover') return;
    if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') { e.preventDefault(); enterBoard(); }
  };
  let touchY = null;
  const onTouchStart = e => { touchY = e.touches[0].clientY; };
  const onTouchMove = e => {
    if (splashMode !== 'cover' || touchY === null) return;
    if (touchY - e.touches[0].clientY > 40) { touchY = null; enterBoard(); }
  };
  const onScrollHint = e => {
    if (splashMode !== 'cover') return;
    const t = e.target instanceof Element ? e.target.closest('.hero-foot .scroll, .hero-entry[data-enter-board]') : null;
    if (!t) return;
    // 捕获阶段拦截：阻止 Astro ViewTransitions 路由器把 BLOG 链接当成跳转
    e.preventDefault();
    e.stopPropagation();
    enterBoard();
  };

  document.addEventListener('wheel', onWheel, { passive: true });
  document.addEventListener('keydown', onKey);
  document.addEventListener('touchstart', onTouchStart, { passive: true });
  document.addEventListener('touchmove', onTouchMove, { passive: true });
  document.addEventListener('click', onScrollHint, true);

  splashCleanup = () => {
    document.removeEventListener('wheel', onWheel);
    document.removeEventListener('keydown', onKey);
    document.removeEventListener('touchstart', onTouchStart);
    document.removeEventListener('touchmove', onTouchMove);
    document.removeEventListener('click', onScrollHint, true);
    document.documentElement.classList.remove('cover-mode');
    pageOffset.inert = false;
    splashGoCover = null;
  };
}

// ── 站点统计：运行天数按本地时区从上线日 00:00 起算，每分钟重算一次（跨天自动 +1，不用刷新）──
// 注意：frontmatter 常量（SITE_EST）在模块化 <script> 里不可访问，这里写死并与 frontmatter 保持一致
const daysEl = document.getElementById('stat-days');
if (daysEl) {
  const siteStart = new Date('2026-07-14T00:00:00').getTime();
  const updateDays = () => {
    daysEl.textContent = String(Math.max(1, Math.floor((Date.now() - siteStart) / 86400000)));
  };
  updateDays();
  setInterval(updateDays, 60000);
}

// ── 滚动显现：分隔线画出、时间轴生长、区块上浮错峰 ──
// （无论是否减动效都绑定类，CSS 的 reduce 媒体查询会强制显示）
document.documentElement.classList.add('js');
const revealEls = [...document.querySelectorAll('.section-head, .tl-item, .rail-card, .sections-item')];
revealEls.forEach(el => el.classList.add('rv'));
document.querySelectorAll('.home-main .tl-item').forEach((el, i) => el.style.setProperty('--rv-delay', `${i * 90}ms`));
document.querySelectorAll('.home-rail .rail-card').forEach((el, i) => el.style.setProperty('--rv-delay', `${i * 120}ms`));

// ── 读者来信：全站最新评论（文章评论 + 留言板留言），失败/为空时保持隐藏 ──
const latestEl = document.getElementById('home-latest-comments');
if (latestEl) {
  fetchRecentComments(serverURL, 3)
    .then(items => {
      if (!items.length) return;
      renderRecentList(latestEl, items, { src: 'slug' });
      latestEl.hidden = false;
    })
    .catch(() => { /* 接口不可用时保持隐藏 */ });
}

const io = new IntersectionObserver((entries) => {
  for (const entry of entries) {
    if (!entry.isIntersecting) continue;
    if (entry.target.classList.contains('timeline')) {
      entry.target.classList.add('tl-draw');
    } else {
      entry.target.classList.add('rv-visible');
    }
    io.unobserve(entry.target);
  }
}, { threshold: 0.2 });
revealEls.forEach(el => io.observe(el));
const timeline = document.querySelector('.timeline');
if (timeline) io.observe(timeline);

if (!reduce) {
  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  tl.from('.hero-avatar', { scale: 0, rotate: -30, duration: 0.7, ease: 'back.out(1.8)' }, 0.15)
    .from('.hero-script', { y: 24, opacity: 0, duration: 0.5 }, 0.35)
    .from('.hero-word span',
      { y: 90, opacity: 0, rotate: () => gsap.utils.random(-14, 14), duration: 0.8, stagger: 0.055, ease: 'back.out(1.6)' },
      0.5)
    .from('.hero-entries a', { y: 18, opacity: 0, duration: 0.45, stagger: 0.08 }, 0.95)
    .from('.hero-icons a', { y: 16, opacity: 0, duration: 0.4, stagger: 0.06 }, 1.05)
    .from('.doodle', { opacity: 0, duration: 0.5, stagger: 0.07 }, 1.15)
    .from('.hero-foot', { opacity: 0, y: 12, duration: 0.5 }, 1.35);

  // 动画结束后清除内联样式，让 CSS :hover 接管字母交互
  tl.then(() => {
    gsap.set('.hero-word span', { clearProps: 'all' });
  });

  // 兜底：rAF 被节流时（后台标签页 / 预渲染），1.6s 后直接跳到终态，内容永不隐形
  setTimeout(() => { if (tl.progress() < 1) tl.progress(1); }, 1600);

  // ── Hero 涂鸦鼠标视差（仅精确指针设备） ──
  const hero = document.querySelector('.hero');
  const doodles = [...document.querySelectorAll('.doodle')];
  if (hero && doodles.length && window.matchMedia('(pointer: fine)').matches) {
    let raf = 0;
    hero.addEventListener('mousemove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const r = hero.getBoundingClientRect();
        const x = e.clientX / r.width - 0.5;
        const y = e.clientY / r.height - 0.5;
        doodles.forEach((d, i) => {
          const depth = 10 + (i % 3) * 7;
          d.style.transform = `translate(${(-x * depth).toFixed(1)}px, ${(-y * depth).toFixed(1)}px)`;
        });
      });
    });
  }
}
});

// ── 导航链接点击 ──
// 左上角 MODUSENSUS 品牌：主页正文态点击 = 渐变回封面（阻止同页跳转）；其他页面保持默认跳转。
// 导航 HOME：只落主页正文不落封面——同页（已在首页封面态）直接切入正文，
// 跨页跳回首页时置旗标，到达后由 astro:page-load 跳过封面（保持滚动位置）。
document.addEventListener('click', e => {
  if (!(e.target instanceof Element)) return;

  const brand = e.target.closest('a.site-nav-brand');
  if (brand) {
    const coverEl = document.getElementById('cover');
    if (!coverEl || splashMode !== 'board' || !splashGoCover) return;
    e.preventDefault();
    splashGoCover();
    return;
  }

  const home = e.target.closest('a.site-nav-link[href="/"]');
  if (!home) return;
  if (window.location.pathname === '/') {
    e.preventDefault();
    if (splashMode === 'cover' && splashEnterBoard) splashEnterBoard();
    return;
  }
  skipCoverFlag = true;
});
</script>
