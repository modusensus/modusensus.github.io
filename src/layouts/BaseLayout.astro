---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'home' | 'threshold' | 'lab' | 'archive' | 'fragments' | 'elsewhere' | 'guestbook' | 'colophon';
}

const {
  title = 'MODUSENSUS — Independent Digital Studio',
  description = '城市、数据与创造力的交汇处。Threshold Notes / Lab / Archive。',
  activeNav = 'home',
} = Astro.props;

const navGroups = [
  [
    { href: '/lab',             label: 'LAB',        key: 'lab' },
    { href: '/threshold-notes', label: 'THRESHOLD',  key: 'threshold' },
    { href: '/archive',         label: 'ARCHIVE',    key: 'archive' },
  ],
  [
    { href: '/fragments',       label: 'FRAGMENTS',  key: 'fragments' },
    { href: '/elsewhere',       label: 'ELSEWHERE',  key: 'elsewhere' },
    { href: '/guestbook',       label: 'GUESTBOOK',  key: 'guestbook' },
  ],
  [
    { href: '/colophon',        label: 'COLOPHON',   key: 'colophon' },
  ],
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="MODUSENSUS" href="/rss.xml" />
  <ViewTransitions />
  <!-- 主题防闪烁：在首帧绘制前确定 data-theme -->
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('modusensus_theme'); } catch (e) {}
      var theme = stored === 'dark' || stored === 'light'
        ? stored
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body>

  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <!-- ── 左侧导航：mix-blend-difference，深浅背景自动反色 ── -->
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/" class="site-nav-brand">MODUSENSUS</a>
    <div class="site-nav-links">
      {navGroups.map((group, groupIndex) => (
        <div class:list={['site-nav-group', { separated: groupIndex > 0 }]}>
          {group.map(link => (
            <a href={link.href} class:list={['site-nav-link', { active: activeNav === link.key }]}>
              {link.label}
            </a>
          ))}
        </div>
      ))}
    </div>
    <div class="site-nav-bottom">
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
        <svg class="icon-moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>
      </button>
      <div class="site-nav-foot">VOL.3<br />2026</div>
    </div>
  </nav>

  <!-- ── 全宽 Hero 插槽（仅首页使用） ── -->
  <slot name="hero" />

  <div class="page-offset">
    <main>
      <slot />
    </main>

    <!-- ── Footer：GitHub / Email / RSS / LinkedIn / Substack ── -->
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <span>MODUSENSUS // INDEPENDENT STUDIO</span>
        <div class="footer-icons">
          <a href="https://github.com/modusensus" class="footer-icon" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            <span>GITHUB</span>
          </a>
          <a href="mailto:hello@modusensus.com" class="footer-icon" aria-label="Email" title="Email">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1.5" y="2.5" width="13" height="11" rx="1"/><path d="M2 4l6 5 6-5"/></svg>
            <span>EMAIL</span>
          </a>
          <a href="/rss.xml" class="footer-icon" aria-label="RSS" title="RSS 订阅">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M2 13.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3z"/><path d="M2 8a6 6 0 016 6H6a4 4 0 00-4-4V8z"/><path d="M2 2a12 12 0 0112 12h-2a10 10 0 00-10-10V2z"/></svg>
            <span>RSS</span>
          </a>
          <a href="https://www.linkedin.com/in/modusensus/" class="footer-icon" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
            <span>LINKEDIN</span>
          </a>
          <a href="https://modusensus.substack.com/" class="footer-icon" target="_blank" rel="noopener" aria-label="Substack" title="Substack">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M3 4h18v2.2H3zM3 8.6h18v2.2H3zM3 13.2h18V21l-9-4.4L3 21z"/></svg>
            <span>SUBSTACK</span>
          </a>
        </div>
        <span>VOL. 3 — 2026 EDITION</span>
      </div>
    </footer>
  </div>

  <script>
    // ── 主题切换：写 localStorage + 同步 giscus iframe 主题 ──
    function applyStoredTheme() {
      try {
        const stored = localStorage.getItem('modusensus_theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) { /* ignore */ }
    }

    function bindThemeToggle() {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('modusensus_theme', next); } catch (e) { /* ignore */ }
        // 同步 giscus iframe 到对应的自定义主题 CSS（public/giscus/），?v= 用于更新后失效缓存
        const giscusTheme = `${location.origin}/giscus/modusensus-${next}.css?v=1`;
        document.querySelectorAll('iframe.giscus-frame').forEach((frame) => {
          frame.contentWindow?.postMessage(
            { giscus: { setConfig: { theme: giscusTheme } } },
            'https://giscus.app',
          );
        });
      });
    }

    bindThemeToggle();
    document.addEventListener('astro:after-swap', () => {
      applyStoredTheme();
      bindThemeToggle();
    });
  </script>
  <Analytics />
</body>
</html>
