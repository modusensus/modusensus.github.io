---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import StatusWidget from '../components/StatusWidget.astro';
import ReaderChip from '../components/ReaderChip.astro';
import LoginModal from '../components/LoginModal.astro';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'home' | 'threshold' | 'lab' | 'archive' | 'fragments' | 'elsewhere' | 'guestbook' | 'colophon';
}

const {
  title = 'MODUSENSUS — Independent Digital Studio',
  description = '城市、数据与创造力的交汇处。Threshold Notes / Lab / Archive。',
  activeNav = 'home',
} = Astro.props;

const navGroups = [
  [
    { href: '/',                label: 'HOME',       key: 'home' },
  ],
  [
    { href: '/threshold-notes', label: 'THRESHOLD',  key: 'threshold' },
    { href: '/lab',             label: 'LAB',        key: 'lab' },
    { href: '/archive',         label: 'ARCHIVE',    key: 'archive' },
  ],
  [
    { href: '/fragments',       label: 'FRAGMENTS',  key: 'fragments' },
    { href: '/elsewhere',       label: 'ELSEWHERE',  key: 'elsewhere' },
    { href: '/guestbook',       label: 'GUESTBOOK',  key: 'guestbook' },
  ],
  [
    { href: '/colophon',        label: 'COLOPHON',   key: 'colophon' },
  ],
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="MODUSENSUS" href="/rss.xml" />
  <ViewTransitions />
  <!-- 主题/强调色防闪烁：在首帧绘制前确定 data-theme 与 data-accent -->
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('modusensus_theme'); } catch (e) {}
      var theme = stored === 'dark' || stored === 'light'
        ? stored
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      // 强调色：默认粉 = 无 data-accent 属性，仅恢复非默认值
      var accent = null;
      try { accent = localStorage.getItem('modusensus_accent'); } catch (e) {}
      if (accent === 'vermilion' || accent === 'amber' || accent === 'pine' || accent === 'indigo') {
        document.documentElement.dataset.accent = accent;
      }
    })();
  </script>
</head>
<body class:list={{ 'is-home': activeNav === 'home' }}>

  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <!-- ── 主题切换擦除层：切换时新主题背景上滑（→ dark）/ 下滑（→ light）盖过整页 ── -->
  <div class="theme-wipe" id="theme-wipe" aria-hidden="true"></div>

  <!-- ── 左侧导航：mix-blend-difference，深浅背景自动反色 ── -->
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/" class="site-nav-brand">MODUSENSUS</a>
    <div class="site-nav-links" id="site-nav-links">
      <div class="site-nav-links-inner">
        {navGroups.map((group, groupIndex) => (
          <div class:list={['site-nav-group', { separated: groupIndex > 0 }]}>
            {group.map(link => (
              <a href={link.href} class:list={['site-nav-link', { active: activeNav === link.key }]}>
                {link.label}
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="site-nav-bottom">
      <!-- 状态小部件锚点：头像按钮对齐此占位（组件 fixed 定位，避开 nav 的 mix-blend-difference） -->
      <div class="nav-status-slot" id="nav-status-slot" aria-hidden="true"></div>
      <div class="nav-actions">
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
          <svg class="icon-moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>
        </button>
        <button class="accent-toggle" id="accent-toggle" type="button" aria-haspopup="true" aria-controls="accent-popover" aria-expanded="false" aria-label="更换强调色" title="更换强调色">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/><circle cx="13.5" cy="6.5" r="0.5" fill="currentColor"/><circle cx="17.5" cy="10.5" r="0.5" fill="currentColor"/><circle cx="8.5" cy="7.5" r="0.5" fill="currentColor"/><circle cx="6.5" cy="12.5" r="0.5" fill="currentColor"/></svg>
        </button>
      </div>
      <!-- 移动端底部导航的菜单开合按钮（≤899px 显示，桌面隐藏） -->
      <button class="nav-menu-toggle" id="nav-menu-toggle" type="button" aria-label="展开菜单" aria-expanded="false" aria-controls="site-nav-links">
        <span class="nav-menu-icon" aria-hidden="true"></span>
      </button>
      <div class="site-nav-foot">VOL.4<br />2026</div>
    </div>
  </nav>

  <!-- ── 调色盘弹框：nav 整体 mix-blend-difference 会让色块反色失真，
       故作为 nav 的兄弟元素独立 fixed 定位显真实色；由导航底部的调色盘按钮开合 ── -->
  <div class="accent-popover" id="accent-popover" role="group" aria-label="强调色选择">
    <span class="accent-popover-label">ACCENT</span>
    <button class="accent-dot" type="button" data-accent="pink" aria-label="强调色：粉（默认）" title="粉 · 默认"></button>
    <button class="accent-dot" type="button" data-accent="vermilion" aria-label="强调色：朱砂" title="朱砂"></button>
    <button class="accent-dot" type="button" data-accent="amber" aria-label="强调色：赭石" title="赭石"></button>
    <button class="accent-dot" type="button" data-accent="pine" aria-label="强调色：松绿" title="松绿"></button>
    <button class="accent-dot" type="button" data-accent="indigo" aria-label="强调色：靛青" title="靛青"></button>
  </div>

  <!-- ── 全宽 Hero 插槽（仅首页使用） ── -->
  <slot name="hero" />

  <div class="page-offset">
    <main>
      <slot />
    </main>

    <!-- ── Footer：品牌块 + 链接列 + 底部工具行（版式参考 Shiro 主题页脚） ── -->
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div class="footer-brand">
          <a href="/" class="footer-brand-name">MODUSENSUS</a>
          <p class="footer-brand-tagline">城市、数据与创造力的交汇处。</p>
          <p class="footer-brand-copy">© 2025-2026 MODUSENSUS<br />Powered by <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> &amp; <a href="https://vercel.com" target="_blank" rel="noopener noreferrer">Vercel</a></p>
        </div>
        <nav class="footer-cols" aria-label="页脚导航">
          <div class="footer-col">
            <div class="footer-col-head">CONTENT</div>
            <a href="/threshold-notes">Threshold Notes</a>
            <a href="/lab">Lab</a>
            <a href="/archive">Archive</a>
            <a href="/fragments">Fragments</a>
          </div>
          <div class="footer-col">
            <div class="footer-col-head">COMMUNITY</div>
            <a href="/elsewhere">Elsewhere · 友链</a>
            <a href="/guestbook">Guestbook · 留言板</a>
            <a href="/colophon">Colophon · 关于</a>
          </div>
          <div class="footer-col">
            <div class="footer-col-head">CONTACT</div>
            <a href="https://github.com/modusensus" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href="mailto:hello@modusensus.com">Email</a>
            <a href="/rss.xml">RSS</a>
            <a href="https://www.linkedin.com/in/modusensus/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <a href="https://modusensus.substack.com/" target="_blank" rel="noopener noreferrer">Substack ↗</a>
          </div>
        </nav>
      </div>
      <div class="container site-footer-bottom">
        <span class="site-online" id="site-online" hidden><i class="online-dot" aria-hidden="true"></i><span id="online-count">–</span> 人在线<span id="visits-sep" hidden> · </span><span id="site-visits" hidden>浏览 0</span></span>
        <span class="site-footer-right">
          <a class="site-footer-icp" href="/colophon#privacy">隐私与安全</a>
          <span>VOL. 4 — 2026 EDITION</span>
          <a class="site-footer-icp" href="https://icp.gov.moe/?keyword=20260447" target="_blank" rel="noopener noreferrer">萌ICP备20260447号</a>
        </span>
      </div>
    </footer>
  </div>

  <!-- ── 右下角站长状态小部件：数据来自自建 /api/status，管理页 /status ── -->
  <StatusWidget />

  <!-- ── 右上角读者身份入口（Waline 登录状态） ── -->
  <ReaderChip />
  <LoginModal />

  <script>
    // ── Waline 浏览量统计（全局）：任何页面出现 .waline-pageview-count 元素都会被填充，
    //    元素上的 data-path 指定计数路径；挂 astro:page-load 适配 ViewTransitions（首次加载与每次路由切换都触发） ──
    import { pageviewCount } from '@waline/client/pageview';
    import { serverURL } from '../config/waline.json';

    document.addEventListener('astro:page-load', () => {
      pageviewCount({ serverURL, path: window.location.pathname });
    });

    // ── 主题切换：写 localStorage + 同步 giscus iframe 主题 ──
    function applyStoredTheme() {
      try {
        const stored = localStorage.getItem('modusensus_theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) { /* ignore */ }
    }

    function bindThemeToggle() {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const de = document.documentElement;
        const current = de.dataset.theme === 'dark' ? 'dark' : 'light';
        const next = current === 'dark' ? 'light' : 'dark';

        const applyTheme = () => {
          de.dataset.theme = next;
          try { localStorage.setItem('modusensus_theme', next); } catch (e) { /* ignore */ }
          // 同步 giscus iframe 到对应的自定义主题 CSS（public/giscus/），?v= 用于更新后失效缓存
          const giscusTheme = `${location.origin}/giscus/modusensus-${next}.css?v=1`;
          document.querySelectorAll('iframe.giscus-frame').forEach((frame) => {
            frame.contentWindow?.postMessage(
              { giscus: { setConfig: { theme: giscusTheme } } },
              'https://giscus.app',
            );
          });
        };

        const wipe = document.getElementById('theme-wipe');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!wipe || reduce) { applyTheme(); return; }

        // 预读目标主题的背景色：同一任务内同步改回 data-theme，不触发中间绘制
        de.dataset.theme = next;
        const targetBg = getComputedStyle(document.body).backgroundColor;
        de.dataset.theme = current;
        if (!targetBg || targetBg === 'transparent') { applyTheme(); return; }

        // 新主题背景上滑（→ dark）/ 下滑（→ light）盖过整页，盖满后切换真实主题并撤掉擦除层
        wipe.classList.remove('up', 'down');
        void wipe.offsetWidth; // 强制回流：连续点击时重启动画
        wipe.style.background = targetBg;
        wipe.classList.add(next === 'dark' ? 'up' : 'down');
        setTimeout(() => {
          applyTheme();
          wipe.classList.remove('up', 'down');
          wipe.style.background = '';
        }, 570);
      });
    }

    // ── 强调色调色盘：按钮开合弹框，html[data-accent] 切换全站强调色（CSS 变量在 global.css），
    //    localStorage 持久化；默认粉 = 无 data-accent 属性 ──
    const ACCENTS = ['pink', 'vermilion', 'amber', 'pine', 'indigo'];

    function applyStoredAccent() {
      try {
        const stored = localStorage.getItem('modusensus_accent');
        if (ACCENTS.indexOf(stored) > -1 && stored !== 'pink') {
          document.documentElement.dataset.accent = stored;
        }
      } catch (e) { /* ignore */ }
    }

    // 点击外部关闭 / Esc 关闭挂在 document 上；路由切换后 DOM 是新的，
    // 需先移除旧监听器再挂新的（否则堆积且引用已替换的旧元素）
    let accentDocHandlers = null;

    function bindAccentPalette() {
      const toggle = document.getElementById('accent-toggle');
      const pop = document.getElementById('accent-popover');
      if (!toggle || !pop) return;
      const dots = pop.querySelectorAll('.accent-dot');

      const isOpen = () => pop.classList.contains('open');
      const setOpen = (open) => {
        pop.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      const syncActive = () => {
        const current = document.documentElement.dataset.accent || 'pink';
        dots.forEach(dot => dot.classList.toggle('active', dot.dataset.accent === current));
      };

      toggle.addEventListener('click', () => setOpen(!isOpen()));
      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          const next = dot.dataset.accent || 'pink';
          if (next === 'pink') {
            delete document.documentElement.dataset.accent;
          } else {
            document.documentElement.dataset.accent = next;
          }
          try { localStorage.setItem('modusensus_accent', next); } catch (e) { /* ignore */ }
          syncActive(); // 选中后弹框保持打开方便连续试色；点外部或 Esc 关闭
        });
      });

      if (accentDocHandlers) {
        document.removeEventListener('click', accentDocHandlers.click);
        document.removeEventListener('keydown', accentDocHandlers.keydown);
      }
      accentDocHandlers = {
        click: (e) => {
          if (!isOpen()) return;
          const t = e.target instanceof Element ? e.target : null;
          if (t && (t.closest('#accent-popover') || t.closest('#accent-toggle'))) return;
          setOpen(false);
        },
        keydown: (e) => { if (e.key === 'Escape' && isOpen()) setOpen(false); },
      };
      document.addEventListener('click', accentDocHandlers.click);
      document.addEventListener('keydown', accentDocHandlers.keydown);

      syncActive();
    }

    // ── 站点统计：进入页面/切换路由上报 view（总浏览 +1 并刷新在线心跳）；
    //    停留期间每 25 秒上报 beat（只刷新心跳）。服务端 Upstash KV 以 65 秒窗口计在线数 ──
    //    浏览计数按浏览器去重：24 小时内同一浏览器只计 1 次（cookie modusensus_visit），
    //    刷新/重复进入不重复计数；路由切换（ViewTransitions）也不重复计
    let onlineBeatTimer = null; // 模块级单例：打包脚本一次完整加载只实例化一次，跨路由切换不重复

    function countViewAllowed() {
      try {
        const m = document.cookie.match(/(?:^|;\s*)modusensus_visit=([^;]*)/);
        if (m) {
          const last = parseInt(m[1], 10);
          if (Number.isFinite(last) && Date.now() - last < 24 * 3600 * 1000) return false;
        }
        document.cookie = `modusensus_visit=${Date.now()}; max-age=86400; path=/; SameSite=Lax`;
        return true;
      } catch { return true; } // cookie 不可用时照常计数
    }

    function beatOnline(sid, type) {
      const wrap = document.getElementById('site-online');
      if (!wrap) return;
      fetch('/api/online', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sid, type }),
      })
        .then(r => (r.ok ? r.json() : null))
        .then(data => {
          if (!data || typeof data.online !== 'number') return;
          const countEl = document.getElementById('online-count');
          if (countEl) countEl.textContent = String(data.online);
          const visitsEl = document.getElementById('site-visits');
          const sepEl = document.getElementById('visits-sep');
          if (visitsEl && sepEl && typeof data.visits === 'number') {
            visitsEl.textContent = `浏览 ${data.visits.toLocaleString('en-US')}`;
            visitsEl.hidden = false;
            sepEl.hidden = false;
          }
          wrap.hidden = false;
        })
        .catch(() => { /* 接口不可用时静默保持隐藏 */ });
    }

    function bindOnlineWidget() {
      const wrap = document.getElementById('site-online');
      if (!wrap) return;
      let sid = null;
      try {
        sid = sessionStorage.getItem('modusensus_sid');
        if (!sid) {
          sid = (crypto.randomUUID && crypto.randomUUID()) || Math.random().toString(36).slice(2) + Date.now().toString(36);
          sessionStorage.setItem('modusensus_sid', sid);
        }
      } catch (e) { sid = 'anon-' + Date.now().toString(36); }

      if (countViewAllowed()) beatOnline(sid, 'view'); // 24h 去重通过才计浏览
      else beatOnline(sid, 'beat'); // 去重未通过也立即上报心跳，在线人数不延迟
      if (!onlineBeatTimer) {
        onlineBeatTimer = setInterval(() => beatOnline(sid, 'beat'), 25000); // 停留期间每 25 秒续心跳
      }
    }

    // ── 移动端底部悬浮导航：菜单按钮开合链接面板（≤899px 生效，桌面按钮隐藏）。
    //    ViewTransitions 路由切换后 nav 是全新 DOM，默认收起状态，需在 after-swap 重新绑定 ──
    function bindMobileNav() {
      const nav = document.querySelector('.site-nav');
      const toggle = nav && nav.querySelector('.nav-menu-toggle');
      if (!nav || !toggle) return;
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    bindThemeToggle();
    bindAccentPalette();
    bindOnlineWidget();
    bindPostPop();
    bindMobileNav();
    document.addEventListener('astro:after-swap', () => {
      applyStoredTheme();
      applyStoredAccent();
      bindThemeToggle();
      bindAccentPalette();
      bindOnlineWidget();
      bindPostPop();
      bindMobileNav();
    });

    // ── 文章行悬浮描述卡：悬停带 data-desc 的文章行时弹出（自下而上），
    //    data-ai 存在时标注「AI 参与」；仅精确指针设备启用，触屏直接点进文章不受影响 ──
    function bindPostPop() {
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      let pop = document.getElementById('post-pop');
      if (!pop) {
        pop = document.createElement('div');
        pop.id = 'post-pop';
        pop.className = 'post-pop';
        pop.setAttribute('aria-hidden', 'true');
        document.body.appendChild(pop);
      }

      const show = (row) => {
        const desc = row.getAttribute('data-desc');
        if (!desc) return;
        pop.textContent = '';
        if (row.hasAttribute('data-ai')) {
          const tag = document.createElement('span');
          tag.className = 'post-pop-ai';
          tag.textContent = 'AI 参与';
          pop.appendChild(tag);
        }
        pop.appendChild(document.createTextNode(desc));
        const r = row.getBoundingClientRect();
        pop.style.left = '0px';
        pop.style.top = '0px';
        pop.classList.add('show');
        const pw = pop.offsetWidth, ph = pop.offsetHeight;
        let left = Math.min(r.left, window.innerWidth - pw - 16);
        left = Math.max(16, left);
        let top = r.bottom + 8; // 默认弹在行下方
        if (top + ph + 8 > window.innerHeight) top = r.top - ph - 8; // 视口底部放不下则弹上方
        pop.style.left = left + 'px';
        pop.style.top = Math.max(8, top) + 'px';
      };
      const hide = () => pop.classList.remove('show');

      document.querySelectorAll('.ar-item[data-desc], .tn-item[data-desc]').forEach(row => {
        row.addEventListener('mouseenter', () => show(row));
        row.addEventListener('mouseleave', hide);
      });
    }

    // ── GSAP 字体编排入场动效（克制的杂志开版感）：
    //    大标题按 <br> 拆行逐行升起 → 头部 mono 标签/副标题/涂鸦接力淡入 → 横线左起划出，
    //    列表项（文章行/便签/友链卡/BUILDS 卡）由 ScrollTrigger 批量上浮浮现。
    //    模块级只注册一次；astro:page-load 首次加载与每次路由切换都触发 ──
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // 把标题内容按 <br> 拆成「遮罩 span > 行 span」，供逐行升起
    function splitTitleLines(title) {
      const parts = title.innerHTML.split(/<br\s*\/?>/i).map(s => s.trim()).filter(Boolean);
      title.innerHTML = parts.map(p => `<span class="ph-mask"><span class="ph-line">${p}</span></span>`).join('');
      return title.querySelectorAll('.ph-line');
    }

    function runIntro() {
      ScrollTrigger.getAll().forEach(t => t.kill()); // 路由切换后旧触发器引用的是已移除的 DOM
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // 1) 页头：标题逐行 + 标签/副标题/涂鸦接力
      const header = document.querySelector('.page-header');
      if (header) {
        const title = header.querySelector('.page-header-title');
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        if (title) {
          const lines = splitTitleLines(title);
          tl.from(lines, { yPercent: 118, duration: 0.7, stagger: 0.09 }, 0);
        }
        const mono = header.querySelector('.mono-label');
        const sub = header.querySelector('.page-header-subtitle');
        const scrawl = header.querySelector('.fragment-scrawl');
        if (mono) tl.from(mono, { opacity: 0, y: 8, duration: 0.45 }, 0.15);
        if (sub) tl.from(sub, { opacity: 0, y: 10, duration: 0.5 }, 0.28);
        if (scrawl) tl.from(scrawl, { opacity: 0, rotation: -11, y: 6, duration: 0.5 }, 0.5);
      }

      // 2) 横线从左划出（钢笔打线）
      const rule = document.querySelector('.board-rule');
      if (rule) {
        gsap.from(rule, { scaleX: 0, transformOrigin: 'left center', duration: 0.55, ease: 'power2.out', delay: 0.25 });
      }

      // 3) 列表项进入视口时批量上浮；clearProps 释放内联 transform，避免盖住 hover 位移
      const items = document.querySelectorAll('.ar-item, .fragment-item, .friend-card, .build-card, .lab-row, .lab-card');
      if (items.length) {
        gsap.set(items, { opacity: 0, y: 24 });
        ScrollTrigger.batch(items, {
          start: 'top 92%',
          once: true,
          onEnter: batch => gsap.to(batch, {
            opacity: 1, y: 0, duration: 0.55, ease: 'power2.out',
            stagger: 0.07, overwrite: true, clearProps: 'transform,opacity',
          }),
        });
      }
    }

    document.addEventListener('astro:page-load', runIntro);
  </script>
  <Analytics />
</body>
</html>
