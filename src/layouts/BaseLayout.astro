---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'home' | 'threshold' | 'lab' | 'archive' | 'colophon';
  /* 是否显示常驻粒子 hero（仅首页开启，避免进入文章时重播） */
  showHero?: boolean;
}

const {
  title = 'MODUSENSUS',
  description = 'Exploring ideas, technology and human creativity.',
  activeNav = 'home',
  showHero = false,
} = Astro.props;

const navLinks = [
  { href: '/',               label: 'Home',            key: 'home'      },
  { href: '/threshold-notes', label: 'Threshold Notes', key: 'threshold' },
  { href: '/lab',            label: 'Lab',             key: 'lab'       },
  { href: '/archive',        label: 'Archive',         key: 'archive'   },
  { href: '/colophon',       label: 'Colophon',        key: 'colophon'  },
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="MODUSENSUS" href="/rss.xml" />
  <ViewTransitions />
  <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
</head>
<body>

  <!-- ── Intro hero（仅首页常驻，GSAP 开场 + 顶部粒子波浪） ── -->
  {showHero && (
    <section class="intro-hero" id="intro-hero">
      <canvas class="hero-particle-wave" id="hero-particle-wave" aria-hidden="true"></canvas>
      <div class="intro-stage" id="intro-stage">
        <div class="intro-dot" id="intro-dot" aria-hidden="true"></div>
        <h1 class="intro-word" id="intro-word" aria-label="MODUSENSUS">
          {Array.from('MODUSENSUS').map((ch, i) => (
            <span class="intro-letter" key={i}>{ch}</span>
          ))}
        </h1>
      </div>
      <div class="intro-tagline">Independent&nbsp;Digital&nbsp;Studio</div>
      <button class="intro-enter" id="intro-enter" type="button" aria-label="Enter site">Enter</button>
    </section>
  )}

  <!-- ── Reading progress bar (article pages) ── -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <!-- ── Navbar ── -->
  <nav class="navbar entrance entrance-1">
    <div class="navbar-inner">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['navbar-link', { active: activeNav === link.key }]}
        >
          {link.label}
        </a>
      ))}
    </div>
    <button class="navbar-menu" aria-label="Menu" id="menu-toggle">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- ── Mobile menu (drawer) ── -->
  <div class="mobile-overlay" id="mobile-overlay" hidden></div>
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-head">
      <span class="mobile-menu-brand">MODUSENSUS</span>
      <button class="mobile-close" id="mobile-close" aria-label="Close menu">
        <span></span><span></span>
      </button>
    </div>
    <nav class="mobile-menu-nav">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['mobile-link', { active: activeNav === link.key }]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="mobile-menu-foot">&copy; 2026 MODUSENSUS</div>
  </div>

  <!-- ── Page content ── -->
  <main>
    <slot />
  </main>

  <!-- ── Footer ── -->
  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-copy">&copy; 2026 MODUSENSUS &middot; Independent Digital Studio</span>
    </div>
  </footer>

</body>
</html>

<style>
/* ── Navbar ── */
.navbar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 2rem;
  height: 52px;
  background: var(--paper);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}
.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  max-width: 1128px;
  width: 100%;
}
.navbar-link {
  font-family: var(--font-ui);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dust, #888);
  text-decoration: none;
  background-image: linear-gradient(var(--accent, #9E2B25), var(--accent, #9E2B25));
  background-repeat: no-repeat;
  background-size: 0% 1.5px;
  background-position: 0 100%;
  padding: 8px 4px 5px;
  transition: color 0.2s, background-size 0.25s ease;
}
.navbar-link:hover,
.navbar-link.active {
  color: var(--ink, #111);
}
.navbar-link:hover {
  background-size: 100% 1px;
}
.navbar-menu {
  display: none;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  padding: 4px;
  cursor: pointer;
}
.navbar-menu span {
  display: block;
  width: 20px;
  height: 1.5px;
  background: var(--ink);
}

/* ── Mobile menu (drawer) ── */
.mobile-overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 17, 17, 0.35);
  z-index: 1000;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.mobile-overlay.open { opacity: 1; }

.mobile-menu {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(78vw, 300px);
  background: var(--paper);
  border-left: 1px solid var(--border);
  z-index: 1001;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  visibility: hidden;
}
.mobile-menu.open {
  transform: translateX(0);
  visibility: visible;
}

.mobile-menu-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  border-bottom: 1px solid var(--border);
}
.mobile-menu-brand {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--ink);
}
.mobile-close {
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  padding: 6px;
  cursor: pointer;
}
.mobile-close span {
  display: block;
  width: 18px;
  height: 1.5px;
  background: var(--ink);
}
.mobile-close span:first-child { transform: rotate(45deg) translate(2px, 2px); }
.mobile-close span:last-child  { transform: rotate(-45deg) translate(2px, -2px); }

.mobile-menu-nav {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 8px 0;
  overflow-y: auto;
}
.mobile-link {
  font-family: var(--font-ui);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 15px 20px;
  border-bottom: 1px solid var(--border);
  color: var(--dust);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: color 0.15s, background 0.15s;
}
.mobile-link::after {
  content: '→';
  font-size: 12px;
  opacity: 0;
  transition: opacity 0.15s, transform 0.15s;
}
.mobile-link.active {
  color: var(--ink);
  font-weight: 700;
}
.mobile-link.active::after {
  opacity: 1;
}
.mobile-link:active {
  color: var(--ink);
  background: var(--accent-bg);
}

.mobile-menu-foot {
  padding: 16px 20px;
  border-top: 1px solid var(--border);
  font-family: var(--font-ui);
  font-size: 10px;
  letter-spacing: 0.08em;
  color: var(--dust);
}

@media (min-width: 769px) {
  .mobile-overlay,
  .mobile-menu { display: none; }
}

/* ── Footer ── */
.footer {
  border-top: 1px solid var(--border);
  margin-top: auto;
  background: var(--paper);
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  position: relative;
  z-index: 2;
}
.footer-copy {
  font-family: var(--font-ui);
  font-size: 10px;
  color: var(--dust);
  letter-spacing: 0.06em;
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .navbar {
    justify-content: flex-end;
    padding: 0 1.25rem;
  }
  .navbar-inner { display: none; }
  .navbar-menu { display: flex; }
  .footer-inner { padding: 1rem 1.25rem; }
}
</style>

<script>
import gsap from 'gsap';

// ── Mobile menu (drawer) toggle ──
function initMenu() {
  const toggle  = document.getElementById('menu-toggle');
  const menu    = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const close   = document.getElementById('mobile-close');
  if (!toggle || !menu || !overlay || !close) return;

  const open = () => {
    menu.classList.add('open');
    menu.setAttribute('aria-hidden', 'false');
    overlay.hidden = false;
    requestAnimationFrame(() => overlay.classList.add('open'));
    document.body.style.overflow = 'hidden';
  };
  const closeMenu = () => {
    menu.classList.remove('open');
    menu.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    // 等淡出动画结束后再隐藏遮罩，避免透明层拦截点击
    setTimeout(() => {
      if (!overlay.classList.contains('open')) overlay.hidden = true;
    }, 300);
  };

  toggle.addEventListener('click', () => {
    if (menu.classList.contains('open')) closeMenu();
    else open();
  });
  close.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);
  // 点击链接后自动收起
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  // Escape 键关闭
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
}

// ── Scroll reveal observer (fade-in + reveal + reveal-stagger) ──
function initReveal() {
  const els = document.querySelectorAll('.fade-in, .reveal, .reveal-stagger');
  if (!els.length) return;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) {
    els.forEach(el => el.classList.add('visible'));
    return;
  }
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  els.forEach(el => obs.observe(el));
}

// ── Reading progress bar (article pages) ──
function initReadingProgress() {
  const bar = document.getElementById('reading-progress');
  if (!bar) return;
  const article = document.querySelector('article.article') || document.body;
  const update = () => {
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const scrolled = Math.max(0, -rect.top);
    const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
    bar.style.width = pct + '%';
    bar.style.opacity = pct > 0 && pct < 100 ? '1' : '0';
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
}

// ── Parallax (subtle magazine depth) ──
function initParallax() {
  const els = document.querySelectorAll('.parallax');
  if (!els.length) return;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) return;
  let ticking = false;
  const update = () => {
    els.forEach(el => {
      const rect = el.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom < 0 || rect.top > vh) return;
      const offset = (rect.top + rect.height / 2 - vh / 2) / vh;
      el.style.transform = `translateY(${(-offset * 12).toFixed(2)}px)`;
    });
    ticking = false;
  };
  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
}

// ── Intro hero — GSAP 开场动画：圆点滚入 → 撞空气墙 → 向右展成线 → 向上展成字 ──
// 仅首次访问播放一次：sessionStorage 持久化标记，刷新 / 导航返回均不重播
// 动画完成后显示“Enter”按钮，点击后隐藏开场区域进入主页；向上滚动不会“回到开场”
function initIntro() {
  const hero = document.getElementById('intro-hero');
  const dot = document.getElementById('intro-dot');
  const word = document.getElementById('intro-word');
  if (!hero || !dot || !word) return;

  const tagline = hero.querySelector('.intro-tagline');
  const enterBtn = document.getElementById('intro-enter');
  const letters = Array.from(word.querySelectorAll('.intro-letter'));

  // 已播放过 / 系统“减少动态效果”：直接隐藏开场区域，跳过动画
  const played = sessionStorage.getItem('ms-intro-played') === '1';
  if (played || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    hero.style.display = 'none';
    return;
  }

  // 点击 Enter：淡出开场区域并隐藏，进入主页
  const enterSite = () => {
    sessionStorage.setItem('ms-intro-played', '1');
    gsap.to(hero, {
      opacity: 0,
      duration: 0.45,
      ease: 'power2.inOut',
      onComplete: () => { hero.style.display = 'none'; }
    });
  };
  if (enterBtn) enterBtn.addEventListener('click', enterSite);

  // 字母初始堆叠在舞台中心，动画时从中心线向上“生长”到各自自然位置
  gsap.set(letters, { y: 42, opacity: 0, scale: 0.55 });

  // 圆点初始在屏幕右侧外
  gsap.set(dot, { x: window.innerWidth * 0.55, scale: 0, rotation: 0, borderRadius: '50%' });

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

  // 1) 圆点从右侧屏幕外滚入，撞向左侧空气墙
  tl.to(dot, {
    x: -window.innerWidth * 0.22,
    scale: 1,
    rotation: -720,
    duration: 1.15,
    ease: 'power2.inOut'
  });

  // 2) 撞墙挤压
  tl.to(dot, {
    x: -window.innerWidth * 0.26,
    scaleX: 0.6,
    scaleY: 1.35,
    rotation: 0,
    duration: 0.16,
    ease: 'power2.in'
  });

  // 3) 反弹并向右拉伸成水平黑线
  tl.to(dot, {
    x: 0,
    scaleX: 30,
    scaleY: 0.05,
    borderRadius: '2px',
    duration: 0.7,
    ease: 'power3.inOut'
  });

  // 4) 黑线向上收束消失，同时字母从中心线向上绽放成字
  tl.to(dot, {
    scaleY: 0,
    opacity: 0,
    duration: 0.35,
    ease: 'power2.in'
  }, '+=0.08');

  tl.fromTo(
    letters,
    { y: 42, opacity: 0, scale: 0.55 },
    {
      y: 0,
      opacity: 1,
      scale: 1,
      duration: 0.85,
      stagger: { each: 0.05, from: 'center' },
      ease: 'elastic.out(1, 0.75)'
    },
    '-=0.15'
  );

  // 5) 标语淡入
  tl.fromTo(tagline, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.35');

  // 6) Enter 按钮淡入（动画完成后出现，等待用户点击进入主页）
  tl.fromTo(
    enterBtn,
    { opacity: 0, y: 10 },
    {
      opacity: 1,
      y: 0,
      duration: 0.5,
      ease: 'power2.out',
      onComplete: () => { enterBtn.style.pointerEvents = 'auto'; }
    },
    '-=0.2'
  );
}

// ── Hero particle wave: 开场动画上下两条方块粒子拱门波浪 ──
let waveRaf = 0;
function initWaveParticles() {
  const canvas = document.getElementById('hero-particle-wave');
  if (!canvas) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  cancelAnimationFrame(waveRaf);

  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const W = canvas.clientWidth;
  const H = canvas.clientHeight;
  if (!W || !H) return;
  canvas.width = W * dpr;
  canvas.height = H * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  const ink = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#1A1A1A';

  // 上下两条拱门波浪：顶部中间向上拱，底部中间向下拱，形成环绕标题的括号
  // 用密集网格采样，接近 demo 那种连续方块点阵；前面粗而实、后面细而疏，强化层次
  const waves = [
    {
      yBase: H * 0.20,
      archAmp: H * 0.13,
      sign: -1,
      layers: [
        // 前面：大粒子、慢、偏下（靠基线），最厚实
        { size: 4.4, alpha: 0.58, speed: 0.55, amp: 24, freq: 0.008, yOffset: 0,   spacing: 9,  density: 0.92 },
        { size: 3.2, alpha: 0.44, speed: 0.85, amp: 20, freq: 0.012, yOffset: -12, spacing: 7,  density: 0.88 },
        // 后面：小粒子、快、上移（向中心偏移），更稀疏更虚
        { size: 1.6, alpha: 0.22, speed: 1.25, amp: 15, freq: 0.017, yOffset: -28, spacing: 5,  density: 0.72 },
      ]
    },
    {
      yBase: H * 0.80,
      archAmp: H * 0.13,
      sign: 1,
      layers: [
        { size: 4.4, alpha: 0.58, speed: 0.55, amp: 24, freq: 0.008, yOffset: 0,   spacing: 9,  density: 0.92 },
        { size: 3.2, alpha: 0.44, speed: 0.85, amp: 20, freq: 0.012, yOffset: 12,  spacing: 7,  density: 0.88 },
        { size: 1.6, alpha: 0.22, speed: 1.25, amp: 15, freq: 0.017, yOffset: 28,  spacing: 5,  density: 0.72 },
      ]
    }
  ];

  // 确定性伪随机：同一位置始终有/无粒子，仅整体向右流动
  const pseudoRandom = (n) => {
    const x = Math.sin(n * 12.9898) * 43758.5453;
    return x - Math.floor(x);
  };

  let t = 0;
  const draw = () => {
    ctx.clearRect(0, 0, W, H);
    t += 1;
    waves.forEach((wave, waveIdx) => {
      wave.layers.forEach((layer, layerIdx) => {
        const span = W + layer.spacing * 8;
        const offset = (t * layer.speed) % span;
        const count = Math.ceil(span / layer.spacing) + 6;
        ctx.fillStyle = ink;
        for (let i = 0; i < count; i++) {
          const px = ((i * layer.spacing + offset) % span) - layer.spacing * 4;
          const seed = waveIdx * 1000 + layerIdx * 100 + i;
          // 拱门基线：中间拱起，两边回落
          const arch = Math.sin((px / W) * Math.PI);
          const archY = wave.sign * arch * wave.archAmp;
          // 多层正弦 + 流动相位制造不规则波浪
          const waveY =
            Math.sin(px * layer.freq + t * 0.02) * layer.amp +
            Math.sin(px * layer.freq * 1.8 + t * 0.035) * layer.amp * 0.55 +
            Math.sin(px * layer.freq * 0.55 + t * 0.012) * layer.amp * 0.35;

          // 沿拱门法线方向（上下）按网格生成多个粒子，形成带状点阵
          const bandHalf = 3; // 每条线厚度方向的粒子数
          for (let b = -bandHalf; b <= bandHalf; b++) {
            const subSeed = seed + b * 3.7;
            // 按层密度跳过，前面厚实、后面稀疏
            if (pseudoRandom(subSeed) > layer.density) continue;
            const band = b * layer.size * 0.85 + (pseudoRandom(subSeed + 1) - 0.5) * layer.size * 0.5;
            const py = wave.yBase + archY + waveY + layer.yOffset + band;
            // 左右边缘淡出
            const edgeFade = Math.min(1, px / 70, (W - px) / 70);
            ctx.globalAlpha = layer.alpha * edgeFade;
            const half = layer.size / 2;
            ctx.fillRect(px - half, py - half, layer.size, layer.size);
          }
        }
      });
    });
    ctx.globalAlpha = 1;
    waveRaf = requestAnimationFrame(draw);
  };
  draw();
}
window.addEventListener('resize', () => initWaveParticles());

// ── Initialize on load + View Transitions ──
function initAll() {
  initIntro();  // 开场动画仅首次访问播放一次（sessionStorage 持久化）
  initWaveParticles();
  initMenu();
  initReveal();
  initReadingProgress();
  initParallax();
}
initAll();
document.addEventListener('astro:after-swap', initAll);
</script>
