---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'home' | 'threshold' | 'lab' | 'archive' | 'colophon';
}

const {
  title = 'MODUSENSUS',
  description = 'Exploring ideas, technology and human creativity.',
  activeNav = 'home',
} = Astro.props;

const navLinks = [
  { href: '/',               label: 'Home',            key: 'home'      },
  { href: '/threshold-notes', label: 'Threshold Notes', key: 'threshold' },
  { href: '/lab',            label: 'Lab',             key: 'lab'       },
  { href: '/archive',        label: 'Archive',         key: 'archive'   },
  { href: '/colophon',       label: 'Colophon',        key: 'colophon'  },
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="MODUSENSUS" href="/rss.xml" />
  <ViewTransitions />
  <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
</head>
<body>

  <!-- ── Reading progress bar (article pages) ── -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <!-- ── Navbar ── -->
  <nav class="navbar entrance entrance-1">
    <div class="navbar-inner">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['navbar-link', { active: activeNav === link.key }]}
        >
          {link.label}
        </a>
      ))}
    </div>
    <button class="navbar-menu" aria-label="Menu" id="menu-toggle">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- ── Mobile menu (drawer) ── -->
  <div class="mobile-overlay" id="mobile-overlay" hidden></div>
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-head">
      <span class="mobile-menu-brand">MODUSENSUS</span>
      <button class="mobile-close" id="mobile-close" aria-label="Close menu">
        <span></span><span></span>
      </button>
    </div>
    <nav class="mobile-menu-nav">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['mobile-link', { active: activeNav === link.key }]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="mobile-menu-foot">&copy; 2026 MODUSENSUS</div>
  </div>

  <!-- ── Page content ── -->
  <main>
    <slot />
  </main>

  <!-- ── Footer ── -->
  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-copy">&copy; 2026 MODUSENSUS &middot; Independent Digital Studio</span>
    </div>
  </footer>

</body>
</html>

<style>
/* ── Navbar ── */
.navbar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 2rem;
  height: 52px;
  background: var(--paper);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}
.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  max-width: 1128px;
  width: 100%;
}
.navbar-link {
  font-family: var(--font-ui);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dust, #888);
  text-decoration: none;
  background-image: linear-gradient(var(--accent, #9E2B25), var(--accent, #9E2B25));
  background-repeat: no-repeat;
  background-size: 0% 1.5px;
  background-position: 0 100%;
  padding: 8px 4px 5px;
  transition: color 0.2s, background-size 0.25s ease;
}
.navbar-link:hover,
.navbar-link.active {
  color: var(--ink, #111);
}
.navbar-link:hover {
  background-size: 100% 1px;
}
.navbar-menu {
  display: none;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  padding: 4px;
  cursor: pointer;
}
.navbar-menu span {
  display: block;
  width: 20px;
  height: 1.5px;
  background: var(--ink);
}

/* ── Mobile menu (drawer) ── */
.mobile-overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 17, 17, 0.35);
  z-index: 1000;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.mobile-overlay.open { opacity: 1; }

.mobile-menu {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(78vw, 300px);
  background: var(--paper);
  border-left: 1px solid var(--border);
  z-index: 1001;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  visibility: hidden;
}
.mobile-menu.open {
  transform: translateX(0);
  visibility: visible;
}

.mobile-menu-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  border-bottom: 1px solid var(--border);
}
.mobile-menu-brand {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--ink);
}
.mobile-close {
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  padding: 6px;
  cursor: pointer;
}
.mobile-close span {
  display: block;
  width: 18px;
  height: 1.5px;
  background: var(--ink);
}
.mobile-close span:first-child { transform: rotate(45deg) translate(2px, 2px); }
.mobile-close span:last-child  { transform: rotate(-45deg) translate(2px, -2px); }

.mobile-menu-nav {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 8px 0;
  overflow-y: auto;
}
.mobile-link {
  font-family: var(--font-ui);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 15px 20px;
  border-bottom: 1px solid var(--border);
  color: var(--dust);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: color 0.15s, background 0.15s;
}
.mobile-link::after {
  content: '→';
  font-size: 12px;
  opacity: 0;
  transition: opacity 0.15s, transform 0.15s;
}
.mobile-link.active {
  color: var(--ink);
  font-weight: 700;
}
.mobile-link.active::after {
  opacity: 1;
}
.mobile-link:active {
  color: var(--ink);
  background: var(--accent-bg);
}

.mobile-menu-foot {
  padding: 16px 20px;
  border-top: 1px solid var(--border);
  font-family: var(--font-ui);
  font-size: 10px;
  letter-spacing: 0.08em;
  color: var(--dust);
}

@media (min-width: 769px) {
  .mobile-overlay,
  .mobile-menu { display: none; }
}

/* ── Footer ── */
.footer {
  border-top: 1px solid var(--border);
  margin-top: auto;
  background: var(--paper);
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
}
.footer-copy {
  font-family: var(--font-ui);
  font-size: 10px;
  color: var(--dust);
  letter-spacing: 0.06em;
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .navbar {
    justify-content: flex-end;
    padding: 0 1.25rem;
  }
  .navbar-inner { display: none; }
  .navbar-menu { display: flex; }
  .footer-inner { padding: 1rem 1.25rem; }
}
</style>

<script>
// ── Mobile menu (drawer) toggle ──
function initMenu() {
  const toggle  = document.getElementById('menu-toggle');
  const menu    = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const close   = document.getElementById('mobile-close');
  if (!toggle || !menu || !overlay || !close) return;

  const open = () => {
    menu.classList.add('open');
    menu.setAttribute('aria-hidden', 'false');
    overlay.hidden = false;
    requestAnimationFrame(() => overlay.classList.add('open'));
    document.body.style.overflow = 'hidden';
  };
  const closeMenu = () => {
    menu.classList.remove('open');
    menu.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    // 等淡出动画结束后再隐藏遮罩，避免透明层拦截点击
    setTimeout(() => {
      if (!overlay.classList.contains('open')) overlay.hidden = true;
    }, 300);
  };

  toggle.addEventListener('click', () => {
    if (menu.classList.contains('open')) closeMenu();
    else open();
  });
  close.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);
  // 点击链接后自动收起
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  // Escape 键关闭
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
}

// ── Scroll reveal observer (fade-in + reveal + reveal-stagger) ──
function initReveal() {
  const els = document.querySelectorAll('.fade-in, .reveal, .reveal-stagger');
  if (!els.length) return;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) {
    els.forEach(el => el.classList.add('visible'));
    return;
  }
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  els.forEach(el => obs.observe(el));
}

// ── Reading progress bar (article pages) ──
function initReadingProgress() {
  const bar = document.getElementById('reading-progress');
  if (!bar) return;
  const article = document.querySelector('article.article') || document.body;
  const update = () => {
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const scrolled = Math.max(0, -rect.top);
    const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
    bar.style.width = pct + '%';
    bar.style.opacity = pct > 0 && pct < 100 ? '1' : '0';
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
}

// ── Parallax (subtle magazine depth) ──
function initParallax() {
  const els = document.querySelectorAll('.parallax');
  if (!els.length) return;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) return;
  let ticking = false;
  const update = () => {
    els.forEach(el => {
      const rect = el.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom < 0 || rect.top > vh) return;
      const offset = (rect.top + rect.height / 2 - vh / 2) / vh;
      el.style.transform = `translateY(${(-offset * 12).toFixed(2)}px)`;
    });
    ticking = false;
  };
  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
}

// ── Initialize on load + View Transitions ──
function initAll() {
  initMenu();
  initReveal();
  initReadingProgress();
  initParallax();
}
initAll();
document.addEventListener('astro:after-swap', initAll);
</script>
