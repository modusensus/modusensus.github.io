---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import StatusWidget from '../components/StatusWidget.astro';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'home' | 'threshold' | 'lab' | 'archive' | 'fragments' | 'elsewhere' | 'guestbook' | 'colophon';
}

const {
  title = 'MODUSENSUS — Independent Digital Studio',
  description = '城市、数据与创造力的交汇处。Threshold Notes / Lab / Archive。',
  activeNav = 'home',
} = Astro.props;

const navGroups = [
  [
    { href: '/lab',             label: 'LAB',        key: 'lab' },
    { href: '/threshold-notes', label: 'THRESHOLD',  key: 'threshold' },
    { href: '/archive',         label: 'ARCHIVE',    key: 'archive' },
  ],
  [
    { href: '/fragments',       label: 'FRAGMENTS',  key: 'fragments' },
    { href: '/elsewhere',       label: 'ELSEWHERE',  key: 'elsewhere' },
    { href: '/guestbook',       label: 'GUESTBOOK',  key: 'guestbook' },
  ],
  [
    { href: '/colophon',        label: 'COLOPHON',   key: 'colophon' },
  ],
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="MODUSENSUS" href="/rss.xml" />
  <ViewTransitions />
  <!-- 主题/强调色防闪烁：在首帧绘制前确定 data-theme 与 data-accent -->
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('modusensus_theme'); } catch (e) {}
      var theme = stored === 'dark' || stored === 'light'
        ? stored
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      // 强调色：默认粉 = 无 data-accent 属性，仅恢复非默认值
      var accent = null;
      try { accent = localStorage.getItem('modusensus_accent'); } catch (e) {}
      if (accent === 'vermilion' || accent === 'amber' || accent === 'pine' || accent === 'indigo') {
        document.documentElement.dataset.accent = accent;
      }
    })();
  </script>
</head>
<body>

  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <!-- ── 左侧导航：mix-blend-difference，深浅背景自动反色 ── -->
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/" class="site-nav-brand">MODUSENSUS</a>
    <div class="site-nav-links">
      {navGroups.map((group, groupIndex) => (
        <div class:list={['site-nav-group', { separated: groupIndex > 0 }]}>
          {group.map(link => (
            <a href={link.href} class:list={['site-nav-link', { active: activeNav === link.key }]}>
              {link.label}
            </a>
          ))}
        </div>
      ))}
    </div>
    <div class="site-nav-bottom">
      <div class="nav-actions">
        <button class="accent-toggle" id="accent-toggle" type="button" aria-haspopup="true" aria-controls="accent-popover" aria-expanded="false" aria-label="更换强调色" title="更换强调色">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/><circle cx="13.5" cy="6.5" r="0.5" fill="currentColor"/><circle cx="17.5" cy="10.5" r="0.5" fill="currentColor"/><circle cx="8.5" cy="7.5" r="0.5" fill="currentColor"/><circle cx="6.5" cy="12.5" r="0.5" fill="currentColor"/></svg>
        </button>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
          <svg class="icon-moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>
        </button>
      </div>
      <div class="site-nav-foot">VOL.4<br />2026</div>
    </div>
  </nav>

  <!-- ── 调色盘弹框：nav 整体 mix-blend-difference 会让色块反色失真，
       故作为 nav 的兄弟元素独立 fixed 定位显真实色；由导航底部的调色盘按钮开合 ── -->
  <div class="accent-popover" id="accent-popover" role="group" aria-label="强调色选择">
    <span class="accent-popover-label">ACCENT</span>
    <button class="accent-dot" type="button" data-accent="pink" aria-label="强调色：粉（默认）" title="粉 · 默认"></button>
    <button class="accent-dot" type="button" data-accent="vermilion" aria-label="强调色：朱砂" title="朱砂"></button>
    <button class="accent-dot" type="button" data-accent="amber" aria-label="强调色：赭石" title="赭石"></button>
    <button class="accent-dot" type="button" data-accent="pine" aria-label="强调色：松绿" title="松绿"></button>
    <button class="accent-dot" type="button" data-accent="indigo" aria-label="强调色：靛青" title="靛青"></button>
  </div>

  <!-- ── 全宽 Hero 插槽（仅首页使用） ── -->
  <slot name="hero" />

  <div class="page-offset">
    <main>
      <slot />
    </main>

    <!-- ── Footer：品牌块 + 链接列 + 底部工具行（版式参考 Shiro 主题页脚） ── -->
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div class="footer-brand">
          <a href="/" class="footer-brand-name">MODUSENSUS</a>
          <p class="footer-brand-tagline">城市、数据与创造力的交汇处。</p>
          <p class="footer-brand-copy">© 2025-2026 MODUSENSUS<br />Powered by <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> &amp; <a href="https://vercel.com" target="_blank" rel="noopener noreferrer">Vercel</a></p>
        </div>
        <nav class="footer-cols" aria-label="页脚导航">
          <div class="footer-col">
            <div class="footer-col-head">CONTENT</div>
            <a href="/threshold-notes">Threshold Notes</a>
            <a href="/lab">Lab</a>
            <a href="/archive">Archive</a>
            <a href="/fragments">Fragments</a>
          </div>
          <div class="footer-col">
            <div class="footer-col-head">COMMUNITY</div>
            <a href="/elsewhere">Elsewhere · 友链</a>
            <a href="/guestbook">Guestbook · 留言板</a>
            <a href="/colophon">Colophon · 关于</a>
          </div>
          <div class="footer-col">
            <div class="footer-col-head">CONTACT</div>
            <a href="https://github.com/modusensus" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href="mailto:hello@modusensus.com">Email</a>
            <a href="/rss.xml">RSS</a>
            <a href="https://www.linkedin.com/in/modusensus/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <a href="https://modusensus.substack.com/" target="_blank" rel="noopener noreferrer">Substack ↗</a>
          </div>
        </nav>
      </div>
      <div class="container site-footer-bottom">
        <span class="site-online" id="site-online" hidden><i class="online-dot" aria-hidden="true"></i><span id="online-count">–</span> 人正在浏览</span>
        <span class="site-footer-right">
          <span>VOL. 4 — 2026 EDITION</span>
          <a class="site-footer-icp" href="https://icp.gov.moe/?keyword=20260447" target="_blank" rel="noopener noreferrer">萌ICP备20260447号</a>
        </span>
      </div>
    </footer>
  </div>

  <!-- ── 右下角站长状态小部件：数据来自自建 /api/status，管理页 /status ── -->
  <StatusWidget />

  <script>
    // ── Waline 浏览量统计（全局）：任何页面出现 .waline-pageview-count 元素都会被填充，
    //    元素上的 data-path 指定计数路径；挂 astro:page-load 适配 ViewTransitions（首次加载与每次路由切换都触发） ──
    import { pageviewCount } from '@waline/client/pageview';
    import { serverURL } from '../config/waline.json';

    document.addEventListener('astro:page-load', () => {
      pageviewCount({ serverURL, path: window.location.pathname });
    });

    // ── 主题切换：写 localStorage + 同步 giscus iframe 主题 ──
    function applyStoredTheme() {
      try {
        const stored = localStorage.getItem('modusensus_theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) { /* ignore */ }
    }

    function bindThemeToggle() {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('modusensus_theme', next); } catch (e) { /* ignore */ }
        // 同步 giscus iframe 到对应的自定义主题 CSS（public/giscus/），?v= 用于更新后失效缓存
        const giscusTheme = `${location.origin}/giscus/modusensus-${next}.css?v=1`;
        document.querySelectorAll('iframe.giscus-frame').forEach((frame) => {
          frame.contentWindow?.postMessage(
            { giscus: { setConfig: { theme: giscusTheme } } },
            'https://giscus.app',
          );
        });
      });
    }

    // ── 强调色调色盘：按钮开合弹框，html[data-accent] 切换全站强调色（CSS 变量在 global.css），
    //    localStorage 持久化；默认粉 = 无 data-accent 属性 ──
    const ACCENTS = ['pink', 'vermilion', 'amber', 'pine', 'indigo'];

    function applyStoredAccent() {
      try {
        const stored = localStorage.getItem('modusensus_accent');
        if (ACCENTS.indexOf(stored) > -1 && stored !== 'pink') {
          document.documentElement.dataset.accent = stored;
        }
      } catch (e) { /* ignore */ }
    }

    // 点击外部关闭 / Esc 关闭挂在 document 上；路由切换后 DOM 是新的，
    // 需先移除旧监听器再挂新的（否则堆积且引用已替换的旧元素）
    let accentDocHandlers = null;

    function bindAccentPalette() {
      const toggle = document.getElementById('accent-toggle');
      const pop = document.getElementById('accent-popover');
      if (!toggle || !pop) return;
      const dots = pop.querySelectorAll('.accent-dot');

      const isOpen = () => pop.classList.contains('open');
      const setOpen = (open) => {
        pop.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      const syncActive = () => {
        const current = document.documentElement.dataset.accent || 'pink';
        dots.forEach(dot => dot.classList.toggle('active', dot.dataset.accent === current));
      };

      toggle.addEventListener('click', () => setOpen(!isOpen()));
      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          const next = dot.dataset.accent || 'pink';
          if (next === 'pink') {
            delete document.documentElement.dataset.accent;
          } else {
            document.documentElement.dataset.accent = next;
          }
          try { localStorage.setItem('modusensus_accent', next); } catch (e) { /* ignore */ }
          syncActive(); // 选中后弹框保持打开方便连续试色；点外部或 Esc 关闭
        });
      });

      if (accentDocHandlers) {
        document.removeEventListener('click', accentDocHandlers.click);
        document.removeEventListener('keydown', accentDocHandlers.keydown);
      }
      accentDocHandlers = {
        click: (e) => {
          if (!isOpen()) return;
          const t = e.target instanceof Element ? e.target : null;
          if (t && (t.closest('#accent-popover') || t.closest('#accent-toggle'))) return;
          setOpen(false);
        },
        keydown: (e) => { if (e.key === 'Escape' && isOpen()) setOpen(false); },
      };
      document.addEventListener('click', accentDocHandlers.click);
      document.addEventListener('keydown', accentDocHandlers.keydown);

      syncActive();
    }

    // ── 在线人数心跳：POST /api/online 上报随机会话标识，服务端以 65 秒窗口计在线数 ──
    let onlineBeatTimer = null; // 模块级单例：打包脚本一次完整加载只实例化一次，跨路由切换不重复

    function beatOnline(sid) {
      const wrap = document.getElementById('site-online');
      if (!wrap) return;
      fetch('/api/online', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sid }),
      })
        .then(r => (r.ok ? r.json() : null))
        .then(data => {
          if (!data || typeof data.online !== 'number') return;
          const countEl = document.getElementById('online-count');
          if (countEl) countEl.textContent = String(data.online);
          wrap.hidden = false;
        })
        .catch(() => { /* 接口不可用时静默保持隐藏 */ });
    }

    function bindOnlineWidget() {
      const wrap = document.getElementById('site-online');
      if (!wrap) return;
      let sid = null;
      try {
        sid = sessionStorage.getItem('modusensus_sid');
        if (!sid) {
          sid = (crypto.randomUUID && crypto.randomUUID()) || Math.random().toString(36).slice(2) + Date.now().toString(36);
          sessionStorage.setItem('modusensus_sid', sid);
        }
      } catch (e) { sid = 'anon-' + Date.now().toString(36); }

      beatOnline(sid); // 每次进入/切换页面立即上报一次
      if (!onlineBeatTimer) {
        onlineBeatTimer = setInterval(() => beatOnline(sid), 25000); // 停留期间每 25 秒续心跳
      }
    }

    bindThemeToggle();
    bindAccentPalette();
    bindOnlineWidget();
    document.addEventListener('astro:after-swap', () => {
      applyStoredTheme();
      applyStoredAccent();
      bindThemeToggle();
      bindAccentPalette();
      bindOnlineWidget();
    });
  </script>
  <Analytics />
</body>
</html>
