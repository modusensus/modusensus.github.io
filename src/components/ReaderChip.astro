---
// ── 右上角读者身份入口 ──
// 读者身份由 Waline 管理（登录/注册动作发生在评论框内），这里做状态显示与入口：
// 未登录显示「读者 · 登录」，已登录显示头像 + 昵称；点击平滑滚到本页评论区，
// 本页没有评论区时跳留言板。桌面端固定右上角；移动端隐藏（顶栏已满，评论区自带身份表单）。
---

<div class="reader-chip" id="reader-chip" hidden>
  <button class="rc-btn" id="rc-btn" type="button" aria-label="读者身份">
    <img class="rc-avatar" id="rc-avatar" alt="" hidden />
    <span class="rc-initial" id="rc-initial" aria-hidden="true" hidden></span>
    <span class="rc-text" id="rc-text">读者 · 登录</span>
  </button>
</div>

<style>
  .reader-chip { position: fixed; top: 13px; right: 16px; z-index: 195; }
  .rc-btn {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.1em; color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule); border-radius: 999px;
    padding: 4px 10px; cursor: pointer;
    box-shadow: 0 3px 10px rgba(26, 26, 26, 0.1);
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }
  .rc-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(26, 26, 26, 0.16); }
  .rc-avatar {
    width: 14px; height: 14px; border-radius: 50%;
    object-fit: cover; border: 1px solid var(--rule-soft);
  }
  .rc-initial {
    display: inline-flex; align-items: center; justify-content: center;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--c-pink); color: #fff;
    font-size: 8.5px; font-weight: 700;
  }
  @media (max-width: 899px) { .reader-chip { display: none; } }
  @media print { .reader-chip { display: none; } }
</style>

<script>
  // WALINE_USER 是 Waline 客户端写在本地的登录用户（v3 字段：display_name / email / url /
  // avatar / token…；头像 URL 由服务端生成）。轮询读取以同步状态（同页登录不触发 storage 事件）
  import { serverURL } from '../config/waline.json';

  function readUser() {
    try { return JSON.parse(localStorage.getItem('WALINE_USER') || 'null'); } catch { return null; }
  }

  function syncChip() {
    const chip = document.getElementById('reader-chip');
    const avatar = document.getElementById('rc-avatar');
    const initial = document.getElementById('rc-initial');
    const text = document.getElementById('rc-text');
    if (!chip || !avatar || !initial || !text) return;
    const u = readUser();
    const name = u && typeof u.display_name === 'string' ? u.display_name : '';
    if (u && name) {
      const url = typeof u.avatar === 'string' && u.avatar ? u.avatar : '';
      if (url) {
        if (avatar.dataset.src !== url) { avatar.src = url; avatar.dataset.src = url; }
        avatar.hidden = false;
        initial.hidden = true;
      } else {
        avatar.hidden = true;
        initial.hidden = false;
        initial.textContent = name.slice(0, 1).toUpperCase();
      }
      text.textContent = name;
    } else {
      avatar.hidden = true;
      initial.hidden = true;
      text.textContent = '读者 · 登录';
    }
    chip.hidden = false;
  }

  // ── 官方弹窗登录：打开 Waline 服务端 /ui/login（含注册），登录后它会向本页
  //    postMessage { type: 'userInfo', data: { token, display_name, email, … } }；
  //    已挂载的 Waline 评论框自身也在监听该消息并自动同步，这里另外写入本地存储、
  //    同步小圆签，并广播 modusensus:waline-user 让评论区脚本重建读取新登录态 ──
  function openLogin() {
    const base = serverURL.replace(/\/$/, '');
    const w = 1024, h = 600;
    const win = window.open(
      `${base}/ui/login?lng=zh-CN`,
      '_blank',
      `width=${w},height=${h},left=${Math.max(0, (window.innerWidth - w) / 2)},top=${Math.max(0, (window.innerHeight - h) / 2)},scrollbars=no,resizable=no,status=no,location=no,toolbar=no,menubar=no`,
    );
    if (!win) { // 弹窗被拦截时退化为当前页打开
      window.location.href = `${base}/ui/login?lng=zh-CN&redirect=${encodeURIComponent(location.href)}`;
      return;
    }
    win.postMessage({ type: 'TOKEN', data: null }, '*');
    const onMsg = ({ data }) => {
      if (!data || typeof data !== 'object' || data.type !== 'userInfo') return;
      if (!data.data || !data.data.token) return;
      window.removeEventListener('message', onMsg);
      try { win.close(); } catch { /* noop */ }
      try { localStorage.setItem('WALINE_USER', JSON.stringify(data.data)); } catch { /* noop */ }
      syncChip();
      document.dispatchEvent(new CustomEvent('modusensus:waline-user'));
    };
    window.addEventListener('message', onMsg);
  }

  function bindChip() {
    const btn = document.getElementById('rc-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const u = readUser();
      if (!u || !u.display_name) { openLogin(); return; }
      // 已登录：滚到本页评论区（本页没有则去留言板）
      const target = document.querySelector('.waline');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const box = (target.closest('.comments, .community-page') || target);
        // 内联样式做一个强调色描边闪烁，提示评论区位置（scoped 样式覆盖不到跨组件 DOM）
        box.style.transition = 'box-shadow 0.4s';
        box.style.boxShadow = '0 0 0 3px var(--c-pink)';
        setTimeout(() => { box.style.boxShadow = ''; }, 1500);
      } else {
        window.location.href = '/guestbook';
      }
    });
    syncChip();
  }

  // astro:page-load 首次加载与每次路由切换都触发，不做额外直调（否则首载绑定两次）
  document.addEventListener('astro:page-load', bindChip);

  let rcTimer = 0; // 模块级单例：一次完整加载只起一个轮询
  if (!rcTimer) rcTimer = setInterval(syncChip, 2000);
</script>
