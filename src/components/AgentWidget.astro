---
// ── 右下角 AI 助理浮窗 ──
// 深色"终端卡"视觉（同 studio 页 04 请柬区配色），z-index 203：
// StatusWidget(202) 之上、首页封面(205) 之下——封面沉浸态不显示，普通页与封面滚入主页态后正常。
// 对话走同源 POST /api/agent（Vercel Function，Upstash KV 存 24h 会话）；503 未配置/网络失败时
// 在对话里推降级文案引导写信，不弹系统错误。
// 挂 astro:page-load 适配 ViewTransitions：模块级状态跨路由保留（翻页对话不丢），DOM 每次重建后重渲染。
---

<div class="agent-widget" id="agent-widget">
  <div class="aw-panel" id="aw-panel" role="dialog" aria-label="与 MODUSENSUS AI 助理对话">
    <div class="aw-head">
      <span class="aw-title"><span class="aw-pulse" aria-hidden="true"></span>ASK · AI 助理</span>
      <span class="aw-head-actions">
        <button class="aw-clear" id="aw-clear" type="button" aria-label="清空对话" title="清空对话（换新会话）">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M2 3.5h10M5.5 3.5V2.2c0-.4.3-.7.7-.7h1.6c.4 0 .7.3.7.7v1.3M3.4 3.5l.5 8c0 .6.5 1 1 1h4.2c.5 0 1-.4 1-1l.5-8M5.8 6v4M8.2 6v4"/></svg>
        </button>
        <button class="aw-close" id="aw-close" type="button" aria-label="收起助理">
          <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M1.5 1.5l9 9M10.5 1.5l-9 9"/></svg>
        </button>
      </span>
    </div>
    <div class="aw-msgs" id="aw-msgs" aria-live="polite"></div>
    <form class="aw-input-row" id="aw-form">
      <input class="aw-input" id="aw-input" type="text" maxlength="500" placeholder="想了解服务或流程？直接问…" autocomplete="off" />
      <button class="aw-send" id="aw-send" type="submit" aria-label="发送">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13L13.5 8 3 3l2.2 5z"/></svg>
      </button>
    </form>
    <p class="aw-foot">AI 生成仅供参考 · 详细需求请<a href="mailto:work@modusensus.space?subject=%E5%B7%A5%E4%BD%9C%E5%AE%A4%E5%92%A8%E8%AF%A2">写信 work@modusensus.space</a></p>
  </div>
  <button class="aw-fab" id="aw-fab" type="button" aria-expanded="false" aria-label="与 AI 助理对话" title="与 AI 助理对话">
    <svg class="aw-fab-spark" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.4l2.1 7.5 7.5 2.1-7.5 2.1-2.1 7.5-2.1-7.5-7.5-2.1 7.5-2.1z"/></svg>
  </button>
</div>

<style>
  .agent-widget { position: fixed; right: 28px; bottom: 28px; z-index: 203; }

  /* ── 悬浮钮：深底四芒星（与 studio 请柬区 doodle 同母题） ── */
  .aw-fab {
    display: flex; align-items: center; justify-content: center;
    width: 54px; height: 54px; margin-left: auto;
    border-radius: 50%; border: 1px solid rgba(239, 234, 224, 0.42);
    background: var(--code-bg); color: var(--c-pink);
    box-shadow: 0 6px 18px rgba(20, 17, 13, 0.38);
    cursor: pointer;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), border-color 0.25s;
  }
  .aw-fab:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 26px rgba(20, 17, 13, 0.46);
    border-color: var(--c-pink);
  }
  .aw-fab-spark { transition: transform 0.4s var(--ease-out); }
  .agent-widget.open .aw-fab-spark { transform: rotate(90deg); }
  .agent-widget.open .aw-fab { border-color: var(--c-pink); }

  /* ── 面板：深色终端卡 ── */
  .aw-panel {
    position: absolute; right: 0; bottom: calc(100% + 14px);
    width: 344px;
    display: flex; flex-direction: column;
    background: var(--code-bg); color: var(--code-fg);
    border: 1px solid rgba(239, 234, 224, 0.14);
    border-top: 3px solid var(--c-pink);
    box-shadow: 0 20px 44px rgba(14, 12, 9, 0.42);
    opacity: 0; visibility: hidden; pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.22s var(--ease-out), transform 0.22s var(--ease-out), visibility 0s 0.22s;
  }
  .agent-widget.open .aw-panel {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.22s var(--ease-out), transform 0.22s var(--ease-out), visibility 0s;
  }

  .aw-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 16px 10px;
    border-bottom: 1px solid rgba(239, 234, 224, 0.1);
  }
  .aw-title {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.16em; color: rgba(239, 234, 224, 0.85);
  }
  /* 呼吸点：助理在线（面板打开即服务端可达与否另看） */
  .aw-pulse {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--c-green);
    box-shadow: 0 0 6px var(--c-green);
    animation: aw-pulse 2s ease-in-out infinite;
  }
  @keyframes aw-pulse {
    0%, 100% { opacity: 1; } 50% { opacity: 0.3; }
  }
  .aw-head-actions { display: flex; align-items: center; gap: 10px; }
  .aw-close, .aw-clear {
    display: flex; padding: 3px;
    color: rgba(239, 234, 224, 0.6); background: none; border: 0; cursor: pointer;
    transition: color 0.2s;
  }
  .aw-close:hover, .aw-clear:hover { color: var(--c-pink); }

  /* ── 消息区 ── */
  .aw-msgs {
    flex: 1; overflow-y: auto;
    display: flex; flex-direction: column; gap: 10px;
    padding: 14px 16px 6px;
    max-height: min(52vh, 400px);
    overscroll-behavior: contain;
  }
  .aw-msg {
    font-family: var(--font-cn); font-size: 13px; line-height: 1.75;
    max-width: 92%;
    padding: 9px 12px;
    white-space: pre-wrap; overflow-wrap: anywhere;
    border-radius: 4px;
  }
  .aw-msg--ai {
    align-self: flex-start;
    background: rgba(239, 234, 224, 0.07);
    border-left: 2px solid var(--c-pink);
    color: var(--code-fg);
  }
  .aw-msg--user {
    align-self: flex-end;
    background: var(--c-pink);
    color: #211e19;
  }

  /* 欢迎块 + 示例问题（无对话时） */
  .aw-greet {
    font-family: var(--font-cn); font-size: 12.5px; line-height: 1.85;
    color: rgba(239, 234, 224, 0.72);
    padding: 2px 2px 4px;
    white-space: pre-wrap;
  }
  .aw-chips { display: flex; flex-direction: column; gap: 7px; }
  .aw-chip {
    align-self: flex-start;
    font-family: var(--font-cn); font-size: 12px;
    color: rgba(239, 234, 224, 0.85);
    background: none;
    border: 1px dashed rgba(239, 234, 224, 0.32);
    border-radius: 999px;
    padding: 5px 13px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .aw-chip:hover { border-color: var(--c-pink); color: var(--c-pink); }

  /* 打字指示 */
  .aw-typing { display: flex; align-items: center; gap: 5px; padding: 7px 12px; }
  .aw-typing i {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--c-pink); opacity: 0.35;
    animation: aw-dot 1.1s ease-in-out infinite;
  }
  .aw-typing i:nth-child(2) { animation-delay: 0.18s; }
  .aw-typing i:nth-child(3) { animation-delay: 0.36s; }
  @keyframes aw-dot {
    0%, 100% { opacity: 0.25; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-3px); }
  }

  /* ── 输入行 ── */
  .aw-input-row {
    display: flex; align-items: center; gap: 8px;
    margin: 10px 16px 0; padding: 0 0 10px;
    border-bottom: 1px solid rgba(239, 234, 224, 0.16);
  }
  .aw-input {
    flex: 1; min-width: 0;
    font-family: var(--font-cn); font-size: 13px;
    color: var(--code-fg);
    background: none; border: 0; outline: 0;
  }
  .aw-input::placeholder { color: rgba(239, 234, 224, 0.35); }
  .aw-send {
    flex: none; display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px;
    border-radius: 50%; border: 0;
    background: var(--c-pink); color: #211e19;
    cursor: pointer;
    transition: transform 0.2s var(--ease-out), opacity 0.2s;
  }
  .aw-send:hover { transform: translateY(-1px); }
  .aw-send:disabled { opacity: 0.4; cursor: default; transform: none; }

  .aw-foot {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.04em;
    color: rgba(239, 234, 224, 0.38);
    padding: 8px 16px 12px; margin: 0;
  }
  .aw-foot a { color: var(--c-pink); border-bottom: 1px solid transparent; }
  .aw-foot a:hover { border-color: var(--c-pink); }

  /* ── 移动端：悬在底部悬浮导航上方 ── */
  @media (max-width: 899px) {
    .agent-widget { right: 14px; bottom: calc(90px + env(safe-area-inset-bottom)); }
    .aw-panel {
      width: min(344px, calc(100vw - 28px));
      right: 0;
      bottom: calc(100% + 12px);
    }
  }
  @media print { .agent-widget { display: none; } }
</style>

<script>
  // ── 助理浮窗逻辑：模块级单例状态 + ViewTransitions 适配 ──
  //    conv/loading/draft 存模块级 → 路由切换后 DOM 重建，从模块状态恢复渲染，对话不丢。
  //    document 级关闭监听器防堆积（先移除旧的再挂新的，同 StatusWidget 模式）。
  let conv = [];        // { role: 'user' | 'assistant', content: string }
  let loading = false;
  let draft = '';
  let open = false;
  let docH = null;
  let sid = null;

  const CHIPS = ['做个个人网站，大概什么流程？', 'AI 智能体定制能帮我做什么？'];
  const GREET = '你好，我是 MODUSENSUS 的 AI 助理——\n服务、流程、合作方式都可以问我。';

  function ensureSid() {
    if (sid) return sid;
    try {
      sid = localStorage.getItem('modusensus_agent_sid');
      if (!sid) {
        sid = 'ag-' + ((crypto.randomUUID && crypto.randomUUID()) || Math.random().toString(36).slice(2, 12) + Date.now().toString(36));
        localStorage.setItem('modusensus_agent_sid', sid);
      }
    } catch (e) { sid = ''; }
    return sid;
  }

  // 纯文本建消息（避免任何 HTML 注入面）
  function addMsg(container, cls, text) {
    const el = document.createElement('div');
    el.className = 'aw-msg ' + cls;
    el.textContent = text;
    container.appendChild(el);
  }

  function render() {
    const wrap = document.getElementById('agent-widget');
    const box = document.getElementById('aw-msgs');
    const send = document.getElementById('aw-send');
    const input = document.getElementById('aw-input');
    const fab = document.getElementById('aw-fab');
    if (!wrap || !box) return;

    wrap.classList.toggle('open', open);
    if (fab) fab.setAttribute('aria-expanded', open ? 'true' : 'false');

    // 重建消息区（消息少，全量渲染成本可忽略）
    box.textContent = '';
    if (!conv.length && !loading) {
      const greet = document.createElement('div');
      greet.className = 'aw-greet';
      greet.textContent = GREET;
      box.appendChild(greet);
      const chips = document.createElement('div');
      chips.className = 'aw-chips';
      CHIPS.forEach(q => {
        const c = document.createElement('button');
        c.type = 'button';
        c.className = 'aw-chip';
        c.textContent = q;
        c.addEventListener('click', () => send(q));
        chips.appendChild(c);
      });
      box.appendChild(chips);
    } else {
      conv.forEach(m => addMsg(box, m.role === 'user' ? 'aw-msg--user' : 'aw-msg--ai', m.content));
      if (loading) {
        const t = document.createElement('div');
        t.className = 'aw-typing';
        t.innerHTML = '<i></i><i></i><i></i>';
        t.setAttribute('aria-label', '助理正在输入');
        box.appendChild(t);
      }
    }
    box.scrollTop = box.scrollHeight;
    if (send) send.disabled = loading;
  }

  async function send(text) {
    text = String(text || '').trim();
    if (!text || loading) return;
    conv.push({ role: 'user', content: text.slice(0, 500) });
    conv = conv.slice(-20);
    draft = '';
    const input = document.getElementById('aw-input');
    if (input) input.value = '';
    loading = true;
    render();

    try {
      const r = await fetch('/api/agent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: conv, sid: ensureSid() }),
      });
      const j = await r.json().catch(() => null);
      if (r.ok && j && typeof j.reply === 'string' && j.reply.trim()) {
        conv.push({ role: 'assistant', content: j.reply.trim().slice(0, 4000) });
      } else if (r.status === 503) {
        conv.push({ role: 'assistant', content: '助理还没配置好，暂时无法回答。\n有需求可以直接写信：work@modusensus.space' });
      } else {
        conv.push({ role: 'assistant', content: '这次没答上来，可能是模型服务暂时不稳定。\n急着聊需求的话，写信 work@modusensus.space 最快。' });
      }
    } catch {
      conv.push({ role: 'assistant', content: '网络开小差了，助理没收到消息。\n也可以直接写信：work@modusensus.space' });
    }
    loading = false;
    render();
    if (input) input.focus();
  }

  function setOpen(v) {
    open = v;
    const input = document.getElementById('aw-input');
    render();
    // 触屏打开时不抢焦点（避免弹出软键盘盖住面板）；精确指针才聚焦
    if (v && input && window.matchMedia('(hover: hover) and (pointer: fine)').matches) input.focus();
  }

  function bindAgentWidget() {
    const wrap = document.getElementById('agent-widget');
    const fab = document.getElementById('aw-fab');
    const close = document.getElementById('aw-close');
    const clear = document.getElementById('aw-clear');
    const form = document.getElementById('aw-form');
    const input = document.getElementById('aw-input');
    if (!wrap || !fab || !close || !clear || !form || !input) return; // 守卫：本页无组件时不做事

    fab.addEventListener('click', () => setOpen(!open));
    close.addEventListener('click', () => setOpen(false));
    // 清空对话：丢掉本地历史 + 换新 sid（旧 KV 会话自然过期），模型不再被旧回复带偏
    const clear = document.getElementById('aw-clear');
    clear.addEventListener('click', () => {
      conv = [];
      loading = false;
      try { localStorage.removeItem('modusensus_agent_sid'); } catch (e) { /* ignore */ }
      sid = null;
      ensureSid();
      render();
    });
    form.addEventListener('submit', (e) => { e.preventDefault(); send(input.value); });
    input.addEventListener('input', () => { draft = input.value; });

    // 路由切换后 DOM 是新的：从模块级状态恢复草稿 + 重渲染
    input.value = draft;
    render();

    // 外点 / Esc 关闭（挂在 document，处理器内实时重查元素）
    if (docH) {
      document.removeEventListener('click', docH.click);
      document.removeEventListener('keydown', docH.keydown);
    }
    docH = {
      click: (e) => {
        const w = document.getElementById('agent-widget');
        if (!w || !w.classList.contains('open')) return;
        const t = e.target instanceof Element ? e.target : null;
        if (t && t.closest('#agent-widget')) return;
        open = false;
        render();
      },
      keydown: (e) => {
        if (e.key === 'Escape' && open) { open = false; render(); }
      },
    };
    document.addEventListener('click', docH.click);
    document.addEventListener('keydown', docH.keydown);
  }

  document.addEventListener('astro:page-load', bindAgentWidget);
</script>
