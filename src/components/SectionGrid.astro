---
interface Props {
  /* 当前选中的栏目（对应页面的活动分区），选中卡片放大变黑 */
  active?: 'threshold' | 'lab' | 'archive';
  title?: string;
}
const { active, title = 'Explore sections' } = Astro.props;

const sections = [
  { key: 'threshold', abbr: 'TN', name: 'Threshold Notes', desc: '数字思想杂志',  href: '/threshold-notes' },
  { key: 'lab',       abbr: 'LB', name: 'Modusensus Lab',  desc: 'AI experiments', href: '/lab' },
  { key: 'archive',   abbr: 'AR', name: 'Archive',         desc: '知识档案',      href: '/archive' },
];
---

<div class="card card-padded">
  <div class="card-label">{title}</div>
  <div class="label-grid">
    {sections.map((s, i) => (
      <a
        href={s.href}
        class:list={['label-tag', { active: active === s.key }]}
      >
        <span class="label-num">{String(i + 1).padStart(2, '0')}</span>
        <span class="label-abbr">{s.abbr}</span>
        <span class="label-name">{s.name}</span>
        <span class="label-desc">{s.desc}</span>
      </a>
    ))}
  </div>
</div>

<style>
/* 商品文艺网格标签：两列卡片，选中/悬停放大变黑 */
.label-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}
.label-tag {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 12px;
  border: 1px solid var(--border-strong);
  border-radius: 2px;
  background: var(--paper);
  text-decoration: none;
  color: inherit;
  transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease,
              transform 0.2s ease, box-shadow 0.2s ease;
}
.label-tag:hover,
.label-tag.active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--paper);
  box-shadow: 0 8px 20px rgba(26, 26, 26, 0.2);
  z-index: 1;
}
.label-tag:hover { transform: translateY(-2px) scale(1.04); }
.label-tag.active { transform: scale(1.06); }

.label-num {
  position: absolute;
  top: 8px;
  right: 10px;
  font-family: var(--font-ui);
  font-size: 9px;
  letter-spacing: 0.08em;
  color: var(--dust);
  transition: color 0.2s ease;
}
.label-tag:hover .label-num,
.label-tag.active .label-num { color: rgba(245, 240, 225, 0.6); }

.label-abbr {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 22px;
  line-height: 1;
  color: var(--accent);
  transition: color 0.2s ease;
}
.label-tag:hover .label-abbr,
.label-tag.active .label-abbr { color: var(--paper); }

.label-name {
  font-family: var(--font-serif);
  font-size: 13px;
  font-weight: 600;
  line-height: 1.25;
  color: var(--ink);
  transition: color 0.2s ease;
}
.label-tag:hover .label-name,
.label-tag.active .label-name { color: var(--paper); }

.label-desc {
  font-family: var(--font-body);
  font-size: 10px;
  color: var(--dust);
  transition: color 0.2s ease;
}
.label-tag:hover .label-desc,
.label-tag.active .label-desc { color: rgba(245, 240, 225, 0.7); }

@media (hover: none) {
  .label-tag:hover {
    transform: none;
    background: var(--paper);
    color: inherit;
    box-shadow: none;
  }
  .label-tag.active { transform: scale(1.02); }
}
</style>
